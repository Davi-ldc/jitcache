#!/usr/bin/env bun
// JITCache's test runner (SPEC-integrator.harness.md section 7). It runs every JS script of the test directories as
// sequences of jsc or Bun processes over one artifact, checks each run (exit, checkers, final status, twin report),
// compares every run that configures JITCache with a JITCache-off run of the same script, the oracle of THREAD
// Verification, which also tells the engine's leaks from JITCache's (section 7.5), with --pin compares each oracle
// option set's code with the pin's (section 11, jitcache-pin-compare.ts),
// and runs testjitcache's C++ groups. With --bench it measures instead of testing (section 9.4): every plain-mode script
// in fresh copies with the bench report on, the minimum and median of each CPU-time span over the copies, and the
// installation bound per body. Its self-tests (JSTests/jitcache/integrator/runner/self-test.ts) import it as a module, so it starts only
// when run as a program.

import { spawn } from "node:child_process";
import {
  appendFileSync,
  closeSync,
  cpSync,
  existsSync,
  mkdirSync,
  mkdtempSync,
  openSync,
  readFileSync,
  readdirSync,
  rmSync,
  statSync,
  writeFileSync,
} from "node:fs";
import { cpus, homedir, loadavg, release, tmpdir, totalmem } from "node:os";
import { basename, dirname, extname, isAbsolute, join, relative, resolve, sep } from "node:path";
import {
  type Architecture,
  type EngineImage,
  type PinComparison,
  type RunCapture,
  compareRuns,
  loadEngineImage,
  pinRunOptions,
  readJITDump,
} from "./jitcache-pin-compare.ts";

export const repositoryRoot = resolve(import.meta.dirname, "../..");
export const corpusRoot = join(repositoryRoot, "JSTests/jitcache");

// Directives are comment lines within a script's first lines (section 7.2).
const directiveLines = 50;

export const lanes = ["ucb", "image", "cb", "ics", "integrator"] as const;
export type Lane = (typeof lanes)[number];
export type Role = "Off" | "Producer" | "ConsumerProducer" | "Consumer" | "Maintenance";
const roles: readonly Role[] = ["Off", "Producer", "ConsumerProducer", "Consumer", "Maintenance"];
const modeFlags = { Producer: "p", ConsumerProducer: "p-c", Consumer: "c" } as const;

export const configuresJITCache = (role: Role) => role === "Producer" || role === "ConsumerProducer" || role === "Consumer";
const produces = (role: Role) => role === "Producer" || role === "ConsumerProducer";
const imports = (role: Role) => role === "Consumer" || role === "ConsumerProducer";

// Section 7.4: the sequence a script that declares none runs, and whether the directory's scripts need a twins build.
// In either mode every directory's runs also get --useConcurrentJIT=false unless their options set it.
const laneDefaults: Record<Lane, { sequence: string; twinsRequired: boolean }> = {
  ucb: { sequence: "Producer --jitcache-delta-at-exit; Consumer", twinsRequired: false },
  image: { sequence: "Producer --jitcache-delta-at-exit; Consumer", twinsRequired: false },
  cb: { sequence: "Producer --jitcache-delta-at-exit; Consumer", twinsRequired: false },
  ics: { sequence: "Producer; Consumer", twinsRequired: true },
  integrator: { sequence: "Producer --jitcache-delta-at-exit; Consumer", twinsRequired: true },
};

// The twin report's spellings (harness sub-SPEC section 2).
export const twinParts = ["ucb", "image", "cb", "ics", "integrator"] as const;
export const twinDomains = ["engine-image", "executable-pool", "structure-reservation", "heap"] as const;

// Section 7.7: of the JITCache flags, those a Bun-hosted run passes to Bun, those it drops, and every other one is
// malformed there, since Bun takes no other (SPEC-integrator.md section 11.2).
const bunPassedFlags = new Set([
  "--jitcache",
  "--jitcache-mode",
  "--jitcache-strict",
  "--jitcache-capture",
  "--jitcache-delta-at-exit",
  "--jitcache-bench-report",
  "--jitcache-twins-report",
  "--jitcache-twins-record-layout",
  "--jitcache-twins-avoid-layout",
  "--jitcache-body-events",
]);
const bunDroppedFlags = new Set(["--jitcache-log", "--jitcache-describe-heap"]);

const hostArchitecture = process.arch === "x64" ? "x86_64" : process.arch === "arm64" ? "aarch64" : process.arch;

// The copies of each sequence the bench runs when --bench-processes names no number.
export const defaultBenchProcesses = 10;

const usage = `Usage: run-jitcache-tests --build=<WebKit build directory> [--bun=<Bun executable>] [--mode=twins|plain]
                         [--pin=<the pin's WebKit build directory>] [--pin-options="<options>"]
                         [--extra-options="<options>"] [--filter=<regex>] [--jobs=<n>] [--timeout=<seconds>]
                         [--js-only | --cpp-only] [--qemu-cpu=<model>] [<test paths>...]
       run-jitcache-tests --bench --build=<WebKit build directory> [--bench-processes=<n>] [--filter=<regex>]
                         [--timeout=<seconds>] [<test paths>...]
--build names <build-root>/linux-<arch>-<profile>/deps/WebKit. A test path is a script, or a directory whose .js and
.mjs files are scripts; the default paths are JSTests/jitcache/ucb, image, cb, ics and integrator. --pin names the
build bun build.ts pin made, whose code each jsc-hosted script's off path must emit; --pin-options adds options to this
build's side of that comparison alone. The runner's own tests, whose fixtures in JSTests/jitcache/integrator/runner/ fail
on purpose, run through bun JSTests/jitcache/integrator/runner/self-test.ts --build=<twins build>.
--bench measures a release-local build instead of testing it: the jsc-hosted scripts plain mode runs, each sequence in
--bench-processes fresh copies (${defaultBenchProcesses} by default), one process at a time under the build lock, with the bench report on.`;

export class UsageError extends Error {}
class CalibrationError extends Error {}

// ---------------------------------------------------------------------------------------------------------------------
// Command line (section 7.1)

export interface RunnerOptions {
  build: string;
  bun: string | null;
  mode: "twins" | "plain" | null; // null: twins exactly when the build has twins
  pin: string | null; // the pin's WebKit build directory (section 11.1)
  pinOptions: string[]; // options this build's side of the pin comparison alone takes
  extraOptions: string[];
  filter: RegExp | null;
  jobs: number;
  timeoutSeconds: number;
  jsOnly: boolean;
  cppOnly: boolean;
  qemuCpu: string | null;
  testPaths: string[];
  bench: boolean; // the bench mode of section 9.4
  benchProcesses: number; // its copies of each sequence
}

// The options the bench mode refuses, since it runs plain mode's jsc-hosted scripts one process at a time with plain
// mode's command lines and no option added, natively and without C++ tests or the pin (section 9.4).
const notInBench = ["--mode", "--bun", "--pin", "--pin-options", "--extra-options", "--jobs", "--js-only", "--cpp-only", "--qemu-cpu"];

export function parseCommandLine(argv: string[]): RunnerOptions {
  const options: RunnerOptions = {
    build: "",
    bun: null,
    mode: null,
    pin: null,
    pinOptions: [],
    extraOptions: [],
    filter: null,
    jobs: 5,
    timeoutSeconds: 600,
    jsOnly: false,
    cppOnly: false,
    qemuCpu: null,
    testPaths: [],
    bench: false,
    benchProcesses: defaultBenchProcesses,
  };
  const given = new Set<string>();
  for (const argument of argv) {
    if (!argument.startsWith("--")) {
      options.testPaths.push(resolve(argument));
      continue;
    }
    const equals = argument.indexOf("=");
    const name = equals < 0 ? argument : argument.slice(0, equals);
    const value = equals < 0 ? null : argument.slice(equals + 1);
    given.add(name);
    const required = () => {
      if (value === null || value === "") throw new UsageError(`${name} needs a value`);
      return value;
    };
    switch (name) {
      case "--build":
        options.build = resolve(required());
        break;
      case "--bun":
        options.bun = resolve(required());
        break;
      case "--mode": {
        const mode = required();
        if (mode !== "twins" && mode !== "plain") throw new UsageError(`--mode is twins or plain, not ${mode}`);
        options.mode = mode;
        break;
      }
      case "--pin":
        options.pin = resolve(required());
        break;
      case "--pin-options":
        options.pinOptions = optionList(value ?? "", "--pin-options");
        break;
      case "--extra-options":
        options.extraOptions = optionList(value ?? "", "--extra-options");
        break;
      case "--filter":
        try {
          options.filter = new RegExp(required());
        } catch (error) {
          throw new UsageError(`--filter is no regular expression: ${(error as Error).message}`);
        }
        break;
      case "--jobs":
        options.jobs = positiveInteger(required(), name);
        break;
      case "--timeout":
        options.timeoutSeconds = positiveInteger(required(), name);
        break;
      case "--js-only":
      case "--cpp-only":
        if (value !== null) throw new UsageError(`${name} takes no value`);
        if (name === "--js-only") options.jsOnly = true;
        else options.cppOnly = true;
        break;
      case "--qemu-cpu":
        options.qemuCpu = required();
        break;
      case "--bench":
        if (value !== null) throw new UsageError("--bench takes no value");
        options.bench = true;
        break;
      case "--bench-processes":
        options.benchProcesses = positiveInteger(required(), name);
        break;
      default:
        throw new UsageError(`unknown option ${argument}`);
    }
  }
  if (!options.build) throw new UsageError("--build is required");
  if (options.jsOnly && options.cppOnly) throw new UsageError("--js-only and --cpp-only exclude each other");
  if (options.pinOptions.length && !options.pin) throw new UsageError("--pin-options needs --pin");
  if (options.bench) {
    const refused = notInBench.filter(name => given.has(name));
    if (refused.length) throw new UsageError(`--bench takes no ${refused.join(", ")}: it runs plain mode's jsc-hosted scripts one process at a time, with plain mode's command lines`);
  } else if (given.has("--bench-processes")) {
    throw new UsageError("--bench-processes needs --bench");
  }
  return options;
}

function positiveInteger(text: string, name: string): number {
  const number = Number(text);
  if (!Number.isInteger(number) || number < 1) throw new UsageError(`${name} takes a positive integer, not ${text}`);
  return number;
}

// A space-separated list of --options, as --extra-options and a run's options are written.
function optionList(text: string, where: string): string[] {
  const options = text.split(/\s+/).filter(Boolean);
  for (const option of options) {
    if (!option.startsWith("--")) throw new UsageError(`${where} holds ${option}, which is no --option`);
  }
  return options;
}

// ---------------------------------------------------------------------------------------------------------------------
// The build

export interface Build {
  directory: string;
  jsc: string;
  testjitcache: string;
  architecture: string;
  twins: boolean; // cmakeconfig.h defines ENABLE_JITCACHE_TWINS as 1
  sanitized: boolean; // CMakeCache.txt sets ENABLE_SANITIZERS to address
  emulated: boolean; // an aarch64 build on an x86_64 host, whose processes run under QEMU user mode (section 7.9)
  emulationRoot: string; // qemu-aarch64 -L
  resultsDirectory: string;
}

export function loadBuild(directory: string): Build {
  const build = resolve(directory);
  if (!statSync(build, { throwIfNoEntry: false })?.isDirectory()) throw new UsageError(`--build names no directory: ${build}`);
  const jsc = join(build, "bin/jsc");
  if (!statSync(jsc, { throwIfNoEntry: false })?.isFile()) throw new UsageError(`${build} holds no bin/jsc`);
  const config = readText(join(build, "cmakeconfig.h")) ?? "";
  const cache = readText(join(build, "CMakeCache.txt")) ?? "";
  const twins = /^#define ENABLE_JITCACHE_TWINS 1\s*$/m.test(config);
  const sanitizers = /^ENABLE_SANITIZERS:[A-Z]+=(.*)$/m.exec(cache)?.[1] ?? "";
  const sanitized = sanitizers.split(/[;,\s]+/).includes("address");
  // <build-root>/linux-<arch>-<profile>/deps/WebKit names its architecture; another layout falls back on the cache.
  const profileDirectory = resolve(build, "../..");
  const laidOut = basename(resolve(build, "..")) === "deps" && /^linux-/.test(basename(profileDirectory));
  const architecture = /^linux-(x86_64|aarch64)-/.exec(basename(profileDirectory))?.[1]
    ?? /^CMAKE_SYSTEM_PROCESSOR:[A-Z]+=(.*)$/m.exec(cache)?.[1]?.trim()
    ?? hostArchitecture;
  const emulated = architecture === "aarch64" && hostArchitecture === "x86_64";
  // The ASan runtime of the aarch64 builds needs glibc 2.34 or newer, which the sysroot build.ts links against lacks.
  const emulationRoot = sanitized
    ? resolve(process.env.JITCACHE_AARCH64_ASAN_ROOT || join(homedir(), "jitcachearm/arm64-glibc-root"))
    : resolve(process.env.JITCACHE_AARCH64_SYSROOT || join(homedir(), "collo-local/tools/linux-sysroot-glibc-arm64"));
  return {
    directory: build,
    jsc,
    testjitcache: join(build, "bin/testjitcache"),
    architecture,
    twins,
    sanitized,
    emulated,
    emulationRoot,
    resultsDirectory: laidOut ? join(dirname(profileDirectory), "jitcache-results") : join(build, "jitcache-results"),
  };
}

// ---------------------------------------------------------------------------------------------------------------------
// Processes

export interface ProcessIO {
  env: Record<string, string | undefined>;
  cwd: string;
  stdout: string; // file paths
  stderr: string;
}

export interface ProcessEnd {
  code: number | null;
  signal: string | null;
  timedOut: boolean;
  error: string | null; // the process could not start
}

export function runProcess(executable: string, args: string[], io: ProcessIO, timeoutSeconds: number): Promise<ProcessEnd> {
  const stdout = openSync(io.stdout, "w");
  const stderr = openSync(io.stderr, "w");
  return new Promise(done => {
    let settled = false;
    let timedOut = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const finish = (end: ProcessEnd) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      closeSync(stdout);
      closeSync(stderr);
      done(end);
    };
    let child: ReturnType<typeof spawn>;
    try {
      child = spawn(executable, args, { cwd: io.cwd, env: io.env, stdio: ["ignore", stdout, stderr] });
    } catch (error) {
      finish({ code: null, signal: null, timedOut: false, error: String((error as Error).message ?? error) });
      return;
    }
    timer = setTimeout(() => {
      timedOut = true;
      child.kill("SIGKILL");
    }, timeoutSeconds * 1000);
    child.on("error", error => finish({ code: null, signal: null, timedOut, error: error.message }));
    child.on("exit", (code, signal) => finish({ code, signal, timedOut, error: null }));
  });
}

// The guest stack sizes of section 7.9: 8 + 64·k MiB with k drawn from 1 to 64, distinct among the processes of one
// sequence, or of one calibration, since under QEMU the stack is the one input that moves the heap (N26). A process
// that belongs to neither, such as testjitcache's, whose heap no twin check compares, draws its k alone.
const guestStackSizes = 64;
const guestStackMiB = (k: number) => 8 + 64 * k;
const drawGuestStack = () => 1 + Math.floor(Math.random() * guestStackSizes);

export class StackSizes {
  private readonly drawn = new Set<number>();

  // runAttempt refuses a sequence that would start more processes than there are sizes, so only a caller that skipped
  // that check can exhaust them.
  next(): number {
    if (this.drawn.size === guestStackSizes) throw new Error(`more than ${guestStackSizes} processes drew from one set of guest stack sizes`);
    let k: number;
    do k = drawGuestStack();
    while (this.drawn.has(k));
    this.drawn.add(k);
    return guestStackMiB(k);
  }
}

export class Launcher {
  constructor(readonly build: Build, readonly timeoutSeconds: number, readonly defaultCpu: string) {}

  // An executable of the build, of the pin or the Bun executable: under QEMU user mode when the build is emulated, as
  // qemu-aarch64 -L <root> -cpu <model> -s <n>M <executable> <arguments> (section 7.9). stacks holds the sizes the
  // process's sequence or calibration drew, and is null for a process outside both.
  engine(executable: string, args: string[], io: ProcessIO, stacks: StackSizes | null, cpu: string | null = null): Promise<ProcessEnd> {
    if (!this.build.emulated) return runProcess(executable, args, io, this.timeoutSeconds);
    const env = { ...io.env };
    // LeakSanitizer cannot start its tracer under QEMU.
    if (this.build.sanitized) env.ASAN_OPTIONS = env.ASAN_OPTIONS ? `${env.ASAN_OPTIONS}:detect_leaks=0` : "detect_leaks=0";
    // qemu-aarch64 8.2.2 reads -s 1G as a 128 KiB stack, so the size is written in M.
    const stack = stacks ? stacks.next() : guestStackMiB(drawGuestStack());
    const qemuArgs = ["-L", this.build.emulationRoot, "-cpu", cpu ?? this.defaultCpu, "-s", `${stack}M`, executable, ...args];
    return runProcess("qemu-aarch64", qemuArgs, { ...io, env }, this.timeoutSeconds);
  }

  // A process of the host, such as a checker, which the Bun that runs this runner runs.
  host(executable: string, args: string[], io: ProcessIO): Promise<ProcessEnd> {
    return runProcess(executable, args, io, this.timeoutSeconds);
  }
}

export function describeEnd(end: ProcessEnd): string {
  if (end.error) return `could not start: ${end.error}`;
  if (end.timedOut) return "timed out";
  if (end.signal) return `ended by ${end.signal}`;
  return `exited with ${end.code}`;
}

// ---------------------------------------------------------------------------------------------------------------------
// Scripts and directives (section 7.2)

export type ExpectedExit = number | "abort" | "kill";
export type TwinKind = "difference" | "skip" | "coincidence";

// A <run index>, alone naming that run of every sequence, or <sequence>:<run> naming one sequence's.
export interface RunAddress {
  sequence: number | null;
  run: number;
}

export interface RunSpec {
  role: Role;
  options: string[]; // a Maintenance run's maintenance command line instead
}

export interface Script {
  path: string;
  display: string;
  lane: Lane | null;
  host: "jsc" | "bun";
  sequences: RunSpec[][];
  requiresTwins: boolean;
  heapOff: string | null;
  pinOff: string | null;
  expectExit: { at: RunAddress; exit: ExpectedExit }[];
  faults: { at: RunAddress; step: string; required: boolean }[];
  expectNoInstall: RunAddress[];
  expectTwin: { at: RunAddress; kind: TwinKind; subject: string }[];
  checks: { at: RunAddress; checker: string }[];
  qemuCpu: { at: RunAddress; model: string }[];
}

export class MalformedScript extends Error {}

export const addresses = (at: RunAddress, sequence: number, run: number) =>
  at.run === run && (at.sequence === null || at.sequence === sequence);

export function displayPath(path: string): string {
  const inCorpus = relative(corpusRoot, path);
  if (!inCorpus.startsWith("..") && !isAbsolute(inCorpus)) return inCorpus;
  const inWorkingDirectory = relative(process.cwd(), path);
  return inWorkingDirectory.startsWith("..") || isAbsolute(inWorkingDirectory) ? path : inWorkingDirectory;
}

// The lane directory a script sits in, at any depth below it: JSTests/jitcache/<lane>/.
export function laneOf(path: string): Lane | null {
  const directories = dirname(resolve(path)).split(sep);
  for (let i = directories.length - 2; i >= 0; --i) {
    const lane = directories[i + 1] as Lane;
    if (directories[i] === "jitcache" && lanes.includes(lane)) return lane;
  }
  return null;
}

function parseSequence(text: string): RunSpec[] {
  const runs = text.split(";").map(run => run.trim());
  if (runs.some(run => !run)) throw new MalformedScript(`jitcache-runs holds an empty run: ${text}`);
  return runs.map(run => {
    const [role, ...options] = run.split(/\s+/);
    if (!roles.includes(role as Role)) throw new MalformedScript(`unknown role ${role} in jitcache-runs`);
    if (role === "Maintenance") {
      if (!options.length) throw new MalformedScript("a Maintenance run needs a maintenance command line");
      return { role: "Maintenance" as Role, options };
    }
    for (const option of options) {
      if (!option.startsWith("--")) throw new MalformedScript(`run option ${option} is no --option`);
    }
    return { role: role as Role, options };
  });
}

function parseAddress(text: string): RunAddress {
  const match = /^(?:(\d+):)?(\d+)$/.exec(text);
  if (!match) throw new MalformedScript(`${text} is no run index`);
  return { sequence: match[1] === undefined ? null : Number(match[1]), run: Number(match[2]) };
}

function parseExpectedExit(text: string): ExpectedExit {
  if (text === "abort" || text === "kill") return text;
  if (!/^\d+$/.test(text) || Number(text) > 255) throw new MalformedScript(`${text} is no exit code, abort or kill`);
  return Number(text);
}

export function parseScript(path: string): Script {
  const absolute = resolve(path);
  const lane = laneOf(absolute);
  const script: Script = {
    path: absolute,
    display: displayPath(absolute),
    lane,
    host: "jsc",
    sequences: [],
    requiresTwins: false,
    heapOff: null,
    pinOff: null,
    expectExit: [],
    faults: [],
    expectNoInstall: [],
    expectTwin: [],
    checks: [],
    qemuCpu: [],
  };
  const singletons = new Set<string>();
  const once = (name: string) => {
    if (singletons.has(name)) throw new MalformedScript(`jitcache-${name} appears twice`);
    singletons.add(name);
  };
  const lines = readFileSync(absolute, "utf8").split("\n").slice(0, directiveLines);
  lines.forEach((line, index) => {
    if (!/^\s*\/\/\s*jitcache-/.test(line)) return;
    const match = /^\s*\/\/\s*jitcache-([a-z0-9-]+):(.*)$/.exec(line);
    if (!match) throw new MalformedScript(`line ${index + 1} is no directive: ${line.trim()}`);
    const [, name, rest] = match;
    const value = rest.trim();
    const words = value.split(/\s+/).filter(Boolean);
    const arity = (count: number) => {
      if (words.length !== count) throw new MalformedScript(`jitcache-${name} takes ${count} words: ${value}`);
    };
    const reason = () => {
      if (words[0] !== "off" || words.length < 2) throw new MalformedScript(`jitcache-${name} reads off <reason>`);
      return words.slice(1).join(" ");
    };
    switch (name) {
      case "runs":
        script.sequences.push(parseSequence(value));
        break;
      case "host":
        once(name);
        if (value !== "jsc" && value !== "bun") throw new MalformedScript(`jitcache-host is jsc or bun, not ${value}`);
        script.host = value;
        break;
      case "requires":
        once(name);
        if (value !== "twins") throw new MalformedScript(`jitcache-requires takes twins, not ${value}`);
        script.requiresTwins = true;
        break;
      case "expect-exit":
        arity(2);
        script.expectExit.push({ at: parseAddress(words[0]), exit: parseExpectedExit(words[1]) });
        break;
      case "expect-fault":
      case "require-fault":
        arity(2);
        script.faults.push({ at: parseAddress(words[0]), step: words[1], required: name === "require-fault" });
        break;
      case "expect-no-install":
        arity(1);
        script.expectNoInstall.push(parseAddress(words[0]));
        break;
      case "expect-twin": {
        arity(3);
        const kind = words[1] as TwinKind;
        const subjects: readonly string[] = kind === "coincidence" ? twinDomains : kind === "difference" || kind === "skip" ? twinParts : [];
        if (!subjects.includes(words[2])) throw new MalformedScript(`jitcache-expect-twin cannot declare ${words[1]} ${words[2]}`);
        script.expectTwin.push({ at: parseAddress(words[0]), kind, subject: words[2] });
        break;
      }
      case "check": {
        arity(2);
        const checker = resolve(dirname(absolute), words[1]);
        if (!statSync(checker, { throwIfNoEntry: false })?.isFile()) throw new MalformedScript(`checker ${words[1]} does not exist`);
        script.checks.push({ at: parseAddress(words[0]), checker });
        break;
      }
      case "heap":
        once(name);
        script.heapOff = reason();
        break;
      case "pin":
        once(name);
        script.pinOff = reason();
        break;
      case "qemu-cpu":
        arity(2);
        script.qemuCpu.push({ at: parseAddress(words[0]), model: words[1] });
        break;
      default:
        throw new MalformedScript(`unknown directive jitcache-${name}`);
    }
  });

  if (!script.sequences.length) {
    if (!lane) throw new MalformedScript("the script declares no jitcache-runs, and its directory gives no default sequence");
    script.sequences.push(parseSequence(laneDefaults[lane].sequence));
  }
  if (lane && laneDefaults[lane].twinsRequired) script.requiresTwins = true;

  const named = (at: RunAddress) =>
    script.sequences.flatMap((runs, k) => runs.flatMap((run, i) => (addresses(at, k, i) ? [run] : [])));
  const allAddresses = [
    ...script.expectExit.map(e => e.at),
    ...script.faults.map(f => f.at),
    ...script.expectNoInstall,
    ...script.expectTwin.map(t => t.at),
    ...script.checks.map(c => c.at),
    ...script.qemuCpu.map(q => q.at),
  ];
  for (const at of allAddresses) {
    if (!named(at).length) throw new MalformedScript(`run ${at.sequence === null ? "" : `${at.sequence}:`}${at.run} names no run`);
  }
  for (const at of script.expectNoInstall) {
    if (named(at).some(run => !imports(run.role))) throw new MalformedScript("jitcache-expect-no-install names a run that is neither a Consumer nor a ConsumerProducer");
  }
  for (const twin of script.expectTwin) {
    if (named(twin.at).some(run => !configuresJITCache(run.role))) throw new MalformedScript("jitcache-expect-twin names a run without JITCache, which writes no twin report");
  }
  return script;
}

// Section 7.7: the option problems that make a Bun-hosted script malformed, given the --extra-options of this run.
export function bunOptionProblem(script: Script, extraOptions: string[]): string | null {
  if (script.host !== "bun") return null;
  for (const runs of script.sequences) {
    for (const run of runs) {
      if (run.role === "Maintenance") continue;
      for (const option of [...extraOptions, ...run.options]) {
        const name = flagName(option);
        if (name.startsWith("--jitcache")) {
          if (!bunPassedFlags.has(name) && !bunDroppedFlags.has(name)) return `Bun takes no ${name}`;
        } else if (!option.includes("=")) {
          return `${option} has no value to pass to Bun as BUN_JSC_${option.slice(2)}`;
        }
      }
    }
  }
  return null;
}

const flagName = (option: string) => {
  const equals = option.indexOf("=");
  return equals < 0 ? option : option.slice(0, equals);
};

// The last value an option list gives a boolean JSC option, or null when none sets it.
function booleanOption(options: string[], name: string): boolean | null {
  let value: boolean | null = null;
  for (const option of options) {
    if (option === `--${name}`) value = true;
    else if (option.startsWith(`--${name}=`)) value = /^(true|yes|1)$/i.test(option.slice(name.length + 3));
  }
  return value;
}

export const expectedExit = (script: Script, sequence: number, run: number): ExpectedExit =>
  script.expectExit.findLast(e => addresses(e.at, sequence, run))?.exit ?? 0;

const endsBySignal = (exit: ExpectedExit) => exit === "abort" || exit === "kill";

export function exitProblem(end: ProcessEnd, expected: ExpectedExit): string | null {
  if (end.error || end.timedOut) return describeEnd(end);
  const signal = expected === "abort" ? "SIGABRT" : expected === "kill" ? "SIGKILL" : null;
  if (signal ? end.signal === signal : end.code === expected && !end.signal) return null;
  return `${describeEnd(end)}, expected ${signal ? `to end by ${signal}` : `to exit with ${expected}`}`;
}

// Section 7.5: the objects LeakSanitizer reported leaked at a process's exit. A record is a header, "Direct leak of 52
// byte(s) in 2 object(s) allocated from:", then one line per frame of the allocation stack, "#0 0x2e7f104 in malloc ...",
// then, under report_objects=1, "Objects leaked above:" and one "0x701a793f5340 (26 bytes)" line per object.
// LeakSanitizer merges every object leaked from one stack into one record and prints their sum, so the runner compares
// objects: each keeps its own size and its record's frames without their program counters, which address randomization
// moves between processes; each frame keeps its function and source line, or its module and offset. A record without
// its object lines counts as one object of its total.
export interface LeakedObject {
  bytes: number;
  stack: string;
}

export function leakedObjects(stderr: string): LeakedObject[] {
  const objects: LeakedObject[] = [];
  const lines = stderr.split("\n");
  for (let n = 0; n < lines.length; ++n) {
    const header = /^(?:Direct|Indirect) leak of (\d+) byte\(s\) in \d+ object\(s\)/.exec(lines[n]);
    if (!header) continue;
    const frames: string[] = [];
    while (/^\s+#\d+ /.test(lines[n + 1] ?? "")) frames.push(lines[++n].trim().replace(/^(#\d+) 0x[0-9a-f]+/, "$1"));
    const stack = frames.join("\n");
    const sizes: number[] = [];
    let m = n + 1;
    while (lines[m] === "") ++m;
    if (lines[m] === "Objects leaked above:") {
      let size: RegExpExecArray | null;
      while ((size = /^0x[0-9a-f]+ \((\d+) bytes\)$/.exec(lines[m + 1] ?? ""))) {
        sizes.push(Number(size[1]));
        ++m;
      }
      n = m;
    }
    for (const bytes of sizes.length ? sizes : [Number(header[1])]) objects.push({ bytes, stack });
  }
  return objects;
}

// Section 7.5: the objects a run leaked that its oracle did not, each paired with at most one oracle object of the same
// size and stack.
export function leaksBeyond(leaked: LeakedObject[], oracle: LeakedObject[]): LeakedObject[] {
  const key = ({ bytes, stack }: LeakedObject) => `${bytes}\n${stack}`;
  const left = new Map<string, number>();
  for (const object of oracle) left.set(key(object), (left.get(key(object)) ?? 0) + 1);
  return leaked.filter(object => {
    const count = left.get(key(object)) ?? 0;
    if (count) left.set(key(object), count - 1);
    return !count;
  });
}

const describeLeaks = (leaks: LeakedObject[]) =>
  `${leaks.length} object(s), the first ${leaks[0].bytes} bytes allocated from ${leaks[0].stack.split("\n").slice(0, 8).join(" <- ")}`;

// ---------------------------------------------------------------------------------------------------------------------
// Results

export interface Failure {
  sequence: number | null; // null for the script as a whole
  attempt: number | null;
  run: number | null;
  role: Role | null;
  check: string;
  detail: string;
}

// HARNESS.md: the runner writes each run's results as JSON lines under the build root. A bench's file names start with
// "bench-".
class ResultsLog {
  readonly path: string;

  constructor(directory: string, fallback: string, prefix = "") {
    const name = `${prefix}${new Date().toISOString().replace(/[:.]/g, "-")}-${process.pid}.jsonl`;
    try {
      mkdirSync(directory, { recursive: true });
      this.path = join(directory, name);
      appendFileSync(this.path, "");
    } catch {
      this.path = join(fallback, name);
    }
  }

  write(record: object) {
    appendFileSync(this.path, `${JSON.stringify(record)}\n`);
  }
}

class Pool {
  private running = 0;
  private readonly waiting: (() => void)[] = [];

  constructor(private readonly size: number) {}

  async run<T>(work: () => Promise<T>): Promise<T> {
    if (this.running >= this.size) await new Promise<void>(resume => this.waiting.push(resume));
    ++this.running;
    try {
      return await work();
    } finally {
      --this.running;
      this.waiting.shift()?.();
    }
  }
}

// ---------------------------------------------------------------------------------------------------------------------
// The session: one invocation of the runner

// What the command lines of section 7.3 depend on beyond the script and the run.
export interface CommandContext {
  readonly twins: boolean;
  readonly extraOptions: string[];
  readonly mallocForceEnabled: boolean; // the calibration of section 7.3 chose WebKitMallocForceEnabled=1
}

// The environment of every jsc or Bun process; twins-mode processes get the calibration's variable.
export function engineEnvironment(context: CommandContext): Record<string, string | undefined> {
  return context.mallocForceEnabled ? { ...process.env, WebKitMallocForceEnabled: "1" } : { ...process.env };
}

// The environment of a run whose leaks the runner judges itself (section 7.5), from the one engineEnvironment or
// bunInvocation gives. When a process leaks, LeakSanitizer ends it with ASan's exitcode in place of its own status, so
// a script that throws and leaks exits 1 where it would exit 3. exitcode=0 keeps the run's status and still prints the
// report leakedObjects reads, and abort_on_error=1 keeps every other sanitizer error fatal: it ends the process by
// SIGABRT, where exitcode=0 would let it exit 0. report_objects=1 lists each leaked object's size, which LeakSanitizer
// reads from LSAN_OPTIONS alone. A process without ASan ignores both variables, and under QEMU the launcher appends
// detect_leaks=0 after these options (section 7.9).
function keepingExitStatus(env: ProcessIO["env"]): ProcessIO["env"] {
  return {
    ...env,
    ASAN_OPTIONS: `${env.ASAN_OPTIONS ? `${env.ASAN_OPTIONS}:` : ""}exitcode=0:abort_on_error=1`,
    LSAN_OPTIONS: `${env.LSAN_OPTIONS ? `${env.LSAN_OPTIONS}:` : ""}report_objects=1`,
  };
}

// What the pin comparison of section 11.2 starts its two runs with: this build's side and the pin's.
export interface PinSetup {
  readonly context: CommandContext;
  readonly build: Build;
  readonly launcher: Launcher;
  readonly pin: Build;
  readonly pinLauncher: Launcher;
  readonly pinOptions: string[]; // this build's side alone takes them (section 7.1)
}

export class Session implements CommandContext {
  readonly mode: "twins" | "plain";
  readonly launcher: Launcher;
  readonly pinSetup: PinSetup | null;
  readonly results: ResultsLog;
  readonly base: string; // the invocation's temporary directory
  readonly pool: Pool;
  mallocForceEnabled = false;
  private calibrated = false;
  readonly listed: string[] = [];
  passed = 0;
  failed = 0;
  skipped = 0;
  private keepBase = false;

  constructor(readonly options: RunnerOptions, readonly build: Build) {
    if (options.mode === "twins" && !build.twins) throw new UsageError(`--mode=twins needs a twins build, and ${build.directory} is none`);
    if (options.qemuCpu !== null && !build.emulated) throw new UsageError("--qemu-cpu applies only to an aarch64 build on an x86_64 host");
    this.mode = options.mode ?? (build.twins ? "twins" : "plain");
    this.launcher = new Launcher(build, options.timeoutSeconds, options.qemuCpu ?? "max");
    this.pinSetup = null;
    if (options.pin) {
      // Section 11.1: the pin runs on the same machine as this build, so both see one CPU feature vector, and under the
      // same emulation when this build's architecture needs it.
      const pin = loadBuild(options.pin);
      if (pin.architecture !== build.architecture) throw new UsageError(`--pin names a ${pin.architecture} build, and ${build.directory} is ${build.architecture}`);
      const pinLauncher = new Launcher(pin, options.timeoutSeconds, options.qemuCpu ?? "max");
      this.pinSetup = { context: this, build, launcher: this.launcher, pin, pinLauncher, pinOptions: options.pinOptions };
    }
    this.base = mkdtempSync(join(tmpdir(), "jitcache-tests-"));
    this.results = new ResultsLog(build.resultsDirectory, this.base);
    this.pool = new Pool(options.jobs);
  }

  get twins() {
    return this.mode === "twins";
  }

  get extraOptions() {
    return this.options.extraOptions;
  }

  // Section 7.3: before the first twins-mode sequence, check that the heap moves between processes, and where it stays
  // put, hand the JSC heap to libpas, whose pages the kernel places (N17).
  async calibrate() {
    if (!this.twins || this.calibrated) return;
    this.calibrated = true;
    const probeNames = ["vm", "cell", "atom"];
    for (const forced of [false, true]) {
      const directory = mkdtempSync(join(this.base, "calibration-"));
      const stacks = new StackSizes();
      const env = forced ? { ...process.env, WebKitMallocForceEnabled: "1" } : { ...process.env };
      const probes: string[][] = [];
      for (let i = 0; i < 2; ++i) {
        const layout = join(directory, `calibration${i}.layout`);
        const io = { env, cwd: directory, stdout: join(directory, `calibration${i}.stdout`), stderr: join(directory, `calibration${i}.stderr`) };
        const args = ["--useDollarVM=true", `--jitcache-twins-record-layout=${layout}`, ...this.options.extraOptions, "-e", ""];
        const end = await this.launcher.engine(this.build.jsc, args, io, stacks);
        // Only the layout matters: a process without --destroy-vm may still end on a leak report.
        const heap = /^heap (\S+) (\S+) (\S+)$/m.exec(readText(layout) ?? "");
        if (!heap) throw new CalibrationError(`calibration process ${i} wrote no heap line (${describeEnd(end)}): ${tail(readText(io.stderr))}`);
        probes.push(heap.slice(1));
      }
      const repeated = probeNames.filter((_, p) => probes[0][p] === probes[1][p]);
      this.results.write({ kind: "calibration", webKitMallocForceEnabled: forced, probes, repeated });
      if (!repeated.length) {
        this.mallocForceEnabled = forced;
        console.log(forced
          ? "calibration: the build's allocator keeps the heap at one base; every twins-mode process gets WebKitMallocForceEnabled=1"
          : "calibration: the heap moves between processes");
        rmSync(directory, { recursive: true, force: true });
        return;
      }
      console.log(`calibration${forced ? " with WebKitMallocForceEnabled=1" : ""}: the ${repeated.join(", ")} probe repeats between two processes`);
    }
    throw new CalibrationError("the heap domain does not move between processes, even with WebKitMallocForceEnabled=1, so no twin check could tell a heap target the image recorded from one it resolves");
  }

  keep() {
    this.keepBase = true;
  }

  // Prints the summary, writes it to the results and returns the exit code.
  finish(error: string | null): number {
    if (error) {
      console.log(`ERROR ${error}`);
      this.failed++;
    }
    for (const line of this.listed) console.log(`listed: ${line}`);
    const exit = this.failed ? 1 : 0;
    this.results.write({ kind: "summary", passed: this.passed, failed: this.failed, skipped: this.skipped, listed: this.listed, error, exit });
    console.log(`${this.passed} passed, ${this.failed} failed, ${this.skipped} skipped`);
    // The results fall back to the temporary directory when the build root takes no file, and then outlive the run too.
    if (this.keepBase || this.results.path.startsWith(`${this.base}${sep}`)) console.log(`kept: ${this.base}`);
    else rmSync(this.base, { recursive: true, force: true });
    console.log(`results: ${this.results.path}`);
    return exit;
  }
}

// ---------------------------------------------------------------------------------------------------------------------
// Run command lines (sections 7.3 and 7.7)

export interface SequencePaths {
  artifact: string;
  scratch: string;
  layouts: string[]; // the layout files earlier runs of the sequence wrote
}

// Section 7.4: in either mode, --useConcurrentJIT=false unless the run's options set useConcurrentJIT. A producer captures
// only what has finalized, so with concurrent JIT on, what a fast release run commits depends on whether its plans
// finished before it exited.
function directoryDefaults(context: CommandContext, script: Script, options: string[]): string[] {
  if (!script.lane || booleanOption(options, "useConcurrentJIT") !== null) return [];
  return ["--useConcurrentJIT=false"];
}

// Whether concurrent JIT is off in a run, by the last setting its command line gives, or JSC's default, on.
export function concurrentJITOff(context: CommandContext, script: Script, options: string[]): boolean {
  const effective = booleanOption([...directoryDefaults(context, script, options), ...context.extraOptions, ...options], "useConcurrentJIT");
  return effective === false;
}

// <jsc> --destroy-vm [JITCache flags] [twins-mode flags] [directory defaults] [extra options] <options> <script> -- ...
// name is run<i> or oracle<j>, which names the files the run writes in the scratch directory.
export function jscArguments(context: CommandContext, script: Script, sequence: number, role: Role, options: string[], paths: SequencePaths, name: string): string[] {
  const { artifact, scratch } = paths;
  const args = ["--destroy-vm"];
  const jitcache = configuresJITCache(role);
  if (jitcache) args.push(`--jitcache=${artifact}`, `--jitcache-mode=${modeFlags[role as keyof typeof modeFlags]}`, "--jitcache-strict=1", "--jitcache-log");
  if (context.twins) {
    args.push("--useDollarVM=true", `--jitcache-describe-heap=${join(scratch, `${name}.heap`)}`);
    if (jitcache) {
      args.push(
        `--jitcache-twins-report=${join(scratch, `${name}.twins`)}`,
        `--jitcache-twins-record-layout=${join(scratch, `${name}.layout`)}`,
        `--jitcache-twins-avoid-layout=${paths.layouts.join(",")}`,
      );
    }
  }
  args.push(...directoryDefaults(context, script, options), ...context.extraOptions, ...options);
  args.push(script.path, "--", role, scratch, artifact, String(sequence));
  return args;
}

// <bun> <JITCache flags> <script> <role> <scratch> <artifact> <sequence>, with the JSC options as BUN_JSC_ variables.
export function bunInvocation(context: CommandContext, script: Script, sequence: number, role: Role, options: string[], paths: SequencePaths, name: string) {
  const { artifact, scratch } = paths;
  const args: string[] = [];
  if (configuresJITCache(role)) {
    args.push(`--jitcache=${artifact}`, `--jitcache-mode=${modeFlags[role as keyof typeof modeFlags]}`, "--jitcache-strict=1");
    if (context.twins) {
      args.push(
        `--jitcache-twins-report=${join(scratch, `${name}.twins`)}`,
        `--jitcache-twins-record-layout=${join(scratch, `${name}.layout`)}`,
        `--jitcache-twins-avoid-layout=${paths.layouts.join(",")}`,
      );
    }
  }
  // --destroy-vm's counterpart, and section 7.4's default as section 7.7 spells it. BUN_DEBUG_QUIET_LOGS=1 turns off the
  // scoped logs a debug Bun writes to standard output, as Bun's own test harness does: they name descriptors, pids,
  // addresses and the process's own output file, which differ between any two processes, so section 7.6 would compare
  // them rather than what the script prints. The apps a script starts inherit it, a release Bun ignores it, and a
  // BUN_DEBUG_<tag> or BUN_DEBUG_ALL the caller exports still wins.
  const env: Record<string, string | undefined> = { ...engineEnvironment(context), BUN_DESTRUCT_VM_ON_EXIT: "1", BUN_DEBUG_QUIET_LOGS: "1" };
  if (directoryDefaults(context, script, options).length) env.BUN_JSC_useConcurrentJIT = "0";
  // Bun hands a BUN_JSC_ variable that Options::setOption rejects to onCrash, so no JITCache flag goes that way.
  for (const option of [...context.extraOptions, ...options]) {
    const flag = flagName(option);
    if (flag.startsWith("--jitcache")) {
      if (bunPassedFlags.has(flag)) args.push(option);
      continue;
    }
    env[`BUN_JSC_${flag.slice(2)}`] = option.slice(flag.length + 1);
  }
  args.push(script.path, role, scratch, artifact, String(sequence));
  return { args, env };
}

// ---------------------------------------------------------------------------------------------------------------------
// One attempt at a sequence

interface Attempt {
  sequence: number;
  attempt: number;
  directory: string;
  failures: Failure[];
  marks: Failure[]; // heap coincidences, which repeat the sequence when they are its only failures
  notes: string[]; // what the runner lists and goes on
  faults: Map<number, Set<string>>; // the fault steps each run's final statuses report
}

interface TwinEntry {
  kind: string;
  part?: string;
  domain?: string;
  check?: string;
  detail?: string;
  reason?: string;
}

const twinMatches = (entry: TwinEntry, declared: { kind: TwinKind; subject: string }) =>
  entry.kind === declared.kind && (declared.kind === "coincidence" ? entry.domain : entry.part) === declared.subject;

function cpuOf(script: Script, sequence: number, run: number): string | null {
  return script.qemuCpu.findLast(q => addresses(q.at, sequence, run))?.model ?? null;
}

async function runAttempt(session: Session, script: Script, k: number, attempt: number): Promise<Attempt> {
  const directory = mkdtempSync(join(session.base, `${script.display.replace(/[^\w.-]+/g, "_")}.s${k}.a${attempt}-`));
  const paths: SequencePaths = { artifact: join(directory, "artifact"), scratch: join(directory, "scratch"), layouts: [] };
  mkdirSync(paths.artifact);
  mkdirSync(paths.scratch);
  const { scratch } = paths;
  const runs = script.sequences[k];
  const stacks = new StackSizes();
  const result: Attempt = { sequence: k, attempt, directory, failures: [], marks: [], notes: [], faults: new Map() };
  const fail = (run: number | null, check: string, detail: string) =>
    result.failures.push({ sequence: k, attempt, run, role: run === null ? null : runs[run].role, check, detail });

  // Under QEMU every process of the sequence, its oracle runs and pin comparisons included, needs a guest stack size of
  // its own (section 7.9).
  const processes = runs.length + oracleOptionSets(runs).length * (comparesWithPin(session, script) ? 3 : 1);
  if (session.build.emulated && processes > guestStackSizes) {
    fail(null, "qemu-stack", `the sequence starts ${processes} processes, and only ${guestStackSizes} guest stack sizes differ under QEMU`);
    return result;
  }

  for (let i = 0; i < runs.length; ++i) {
    const run = runs[i];
    const name = `run${i}`;
    const expected = expectedExit(script, k, i);
    // The runner judges the leaks of every run that reaches LeakSanitizer's check at exit (section 7.5). A run expected
    // to end by a signal never does, so it keeps ASan's defaults, where abort_on_error=1 would pass any sanitizer error
    // as the abort it expects.
    const judged = !endsBySignal(expected);
    const io = (env: ProcessIO["env"]): ProcessIO => ({
      env: judged ? keepingExitStatus(env) : env,
      cwd: scratch,
      stdout: join(scratch, `${name}.stdout`),
      stderr: join(scratch, `${name}.stderr`),
    });
    let end: ProcessEnd;
    if (run.role === "Maintenance") {
      // <jsc> --jitcache-maintenance -- <command>, as section 7.3 writes it: maintenance runs before JSC::initialize
      // and runs no JavaScript, so neither the directory's defaults nor --extra-options, which vary how JSC runs, apply.
      const command = run.options.map(word => word.replaceAll("$ARTIFACT", paths.artifact));
      end = await session.launcher.engine(session.build.jsc, ["--jitcache-maintenance", "--", ...command], io(engineEnvironment(session)), stacks, cpuOf(script, k, i));
    } else if (script.host === "jsc") {
      end = await session.launcher.engine(session.build.jsc, jscArguments(session, script, k, run.role, run.options, paths, name), io(engineEnvironment(session)), stacks, cpuOf(script, k, i));
    } else {
      const { args, env } = bunInvocation(session, script, k, run.role, run.options, paths, name);
      end = await session.launcher.engine(session.options.bun!, args, io(env), stacks, cpuOf(script, k, i));
    }

    // Section 7.5, after each run.
    const exit = exitProblem(end, expected);
    if (exit) fail(i, end.timedOut ? "timeout" : "exit", exit);
    // An Off run's leaks are the engine's, and runOracle judges those of a run that configures JITCache. A Maintenance
    // run has no oracle, so every leak it reports fails it.
    if (run.role === "Maintenance" && judged) {
      const leaked = leakedObjects(readText(join(scratch, `${name}.stderr`)) ?? "");
      if (leaked.length) fail(i, "leak", `the run has no oracle, and it leaked ${describeLeaks(leaked)}`);
    }
    for (const { checker } of script.checks.filter(c => addresses(c.at, k, i))) {
      const label = `${name}.${basename(checker, extname(checker))}`;
      const checkerIO = { env: { ...process.env }, cwd: scratch, stdout: join(scratch, `${label}.stdout`), stderr: join(scratch, `${label}.stderr`) };
      const checked = await session.launcher.host(process.execPath, [checker, join(scratch, `${name}.stdout`), join(scratch, `${name}.stderr`), scratch], checkerIO);
      if (checked.error || checked.timedOut || checked.code !== 0) fail(i, "checker", `${displayPath(checker)} ${describeEnd(checked)}: ${tail(readText(checkerIO.stderr) || readText(checkerIO.stdout))}`);
    }
    if (!configuresJITCache(run.role)) continue;
    const layout = join(scratch, `${name}.layout`);
    if (session.twins && existsSync(layout)) paths.layouts.push(layout);
    // Bun writes final statuses only in twins mode, and a run that ends by a signal writes none.
    if (!endsBySignal(expected) && (script.host === "jsc" || session.twins)) checkStatuses(script, k, i, run, readText(join(scratch, `${name}.stderr`)) ?? "", result, fail);
    if (session.twins) checkTwinReports(session, script, k, i, runs, scratch, attempt, result, fail);
  }

  await runOracle(session, script, k, runs, paths, stacks, result, fail);
  if (comparesWithPin(session, script)) await runPinComparison(session, script, k, attempt, runs, paths, stacks, result, fail);
  return result;
}

type Fail = (run: number | null, check: string, detail: string) => void;

// Section 7.5: the final statuses a run with JITCache wrote to standard error.
function checkStatuses(script: Script, k: number, i: number, run: RunSpec, stderr: string, result: Attempt, fail: Fail) {
  const statuses: any[] = [];
  for (const line of stderr.split("\n")) {
    if (!line.startsWith('{"jitcache":"status"')) continue;
    try {
      statuses.push(JSON.parse(line));
    } catch {
      fail(i, "status", `a status line is no JSON: ${line}`);
    }
  }
  if (!statuses.length) {
    fail(i, "status", "the run wrote no final status");
    return;
  }
  const allowed = new Set(script.faults.filter(f => addresses(f.at, k, i)).map(f => f.step));
  const reported = new Set<string>();
  for (const status of statuses) {
    for (const fault of [status.activityFault, status.productionFault]) {
      if (!fault || reported.has(fault.step)) continue;
      reported.add(fault.step);
      if (!allowed.has(fault.step)) fail(i, "fault", `the status reports ${fault.class} at ${fault.step}, which no directive declares${fault.detail ? `: ${fault.detail}` : ""}`);
    }
  }
  result.faults.set(i, reported);
  if (imports(run.role) && !script.expectNoInstall.some(at => addresses(at, k, i))) {
    const installs = statuses.reduce((sum, status) => sum + Number(status.progress?.installs ?? 0), 0);
    if (!installs) fail(i, "install", `the ${run.role} installed no body`);
  }
}

// Section 7.5: a run's twin reports, the main VM's and, for Bun, each worker VM's.
function checkTwinReports(session: Session, script: Script, k: number, i: number, runs: RunSpec[], scratch: string, attempt: number, result: Attempt, fail: Fail) {
  const name = `run${i}.twins`;
  if (!existsSync(join(scratch, name))) {
    fail(i, "twin-report", "the run wrote no twin report");
    return;
  }
  const files = [name, ...readdirSync(scratch).filter(file => file.startsWith(`${name}.`)).sort()];
  const entries: TwinEntry[] = [];
  for (const file of files) {
    (readText(join(scratch, file)) ?? "").split("\n").forEach((line, index) => {
      if (!line.trim()) return;
      try {
        entries.push(JSON.parse(line));
      } catch {
        fail(i, "twin-report", `${file}:${index + 1} is no JSON line: ${line}`);
      }
    });
  }
  const declared = script.expectTwin.filter(t => addresses(t.at, k, i));
  for (const twin of declared) {
    if (!entries.some(entry => twinMatches(entry, twin))) fail(i, "twin-expected", `no ${twin.kind} report of ${twin.subject} appeared, which jitcache-expect-twin requires`);
  }
  // Section 7.4: a skip fails the run exactly when concurrent JIT is off in it and in every earlier run that produced.
  const offIn = (j: number) => concurrentJITOff(session, script, runs[j].options);
  const skipFails = offIn(i) && runs.every((run, j) => j >= i || !produces(run.role) || offIn(j));
  for (const entry of entries) {
    if (declared.some(twin => twinMatches(entry, twin))) continue;
    if (entry.kind === "difference") fail(i, "twin-difference", `${entry.part} ${entry.check}: ${entry.detail}`);
    else if (entry.kind === "skip" && skipFails) fail(i, "twin-skip", `${entry.part} ${entry.check} skipped with concurrent JIT off in this run and every earlier producing run: ${entry.reason}`);
    else if (entry.kind === "skip") result.notes.push(`run ${i} skipped ${entry.part} ${entry.check}: ${entry.reason}`);
    else if (entry.kind === "coincidence" && entry.domain === "heap" && attempt === 1) {
      result.marks.push({ sequence: k, attempt, run: i, role: runs[i].role, check: "twin-coincidence", detail: `heap: ${entry.detail}` });
    } else if (entry.kind === "coincidence") fail(i, "twin-coincidence", `${entry.domain}: ${entry.detail}`);
    else fail(i, "twin-report", `a report of unknown kind ${entry.kind}`);
  }
}

// Section 7.6: the oracle's option sets, numbered j in this order, each a run's options without the JITCache ones and
// the runs that configure JITCache with them.
export function oracleOptionSets(runs: RunSpec[]): { options: string[]; runs: number[] }[] {
  const sets = new Map<string, { options: string[]; runs: number[] }>();
  runs.forEach((run, i) => {
    if (!configuresJITCache(run.role)) return;
    const options = run.options.filter(option => !option.startsWith("--jitcache"));
    const key = JSON.stringify(options);
    if (!sets.has(key)) sets.set(key, { options, runs: [] });
    sets.get(key)!.runs.push(i);
  });
  return [...sets.values()];
}

// Section 7.6: every run that configures JITCache against an Off run of its own options without the JITCache ones,
// one oracle run per distinct option set.
async function runOracle(session: Session, script: Script, k: number, runs: RunSpec[], paths: SequencePaths, stacks: StackSizes, result: Attempt, fail: Fail) {
  const { scratch } = paths;
  let j = 0;
  for (const { options, runs: compared } of oracleOptionSets(runs)) {
    const name = `oracle${j}`;
    // No exit check reads an oracle run's status, so every oracle run takes the environment that prints its leaks.
    const io: ProcessIO = { env: keepingExitStatus(engineEnvironment(session)), cwd: scratch, stdout: join(scratch, `${name}.stdout`), stderr: join(scratch, `${name}.stderr`) };
    // An oracle run is no run a jitcache-qemu-cpu index names, so under QEMU it takes --qemu-cpu's model (section 7.9).
    let end: ProcessEnd;
    if (script.host === "jsc") {
      end = await session.launcher.engine(session.build.jsc, jscArguments(session, script, k, "Off", options, paths, name), io, stacks);
    } else {
      const { args, env } = bunInvocation(session, script, k, "Off", options, paths, name);
      end = await session.launcher.engine(session.options.bun!, args, { ...io, env: keepingExitStatus(env) }, stacks);
    }
    const oracleOutput = readBytes(io.stdout);
    const oracleLeaks = leakedObjects(readText(io.stderr) ?? "");
    const heapCompared = session.twins && script.host === "jsc" && !script.heapOff;
    const oracleHeap = heapCompared ? readBytes(join(scratch, `${name}.heap`)) : null;
    for (const i of compared) {
      const output = readBytes(join(scratch, `run${i}.stdout`));
      if (!output.equals(oracleOutput)) fail(i, "oracle-output", `its output differs from oracle ${j}'s (${describeEnd(end)}) ${firstDifference(output, oracleOutput)}`);
      // A run that ends by a signal never reaches the end of the run, where LeakSanitizer checks for leaks and the shell
      // writes its heap description.
      if (endsBySignal(expectedExit(script, k, i))) continue;
      // Section 7.5: a leak passes when the oracle reports it too, the engine's own.
      const leaked = leaksBeyond(leakedObjects(readText(join(scratch, `run${i}.stderr`)) ?? ""), oracleLeaks);
      if (leaked.length) fail(i, "leak", `of the objects it leaked, oracle ${j} (${describeEnd(end)}) reports no match for ${describeLeaks(leaked)}`);
      if (!heapCompared) continue;
      const heapFile = join(scratch, `run${i}.heap`);
      if (!existsSync(heapFile)) fail(i, "oracle-heap", "the run wrote no heap description");
      else if (!existsSync(join(scratch, `${name}.heap`))) fail(i, "oracle-heap", `oracle ${j} wrote no heap description (${describeEnd(end)})`);
      else {
        const heap = readBytes(heapFile);
        if (!heap.equals(oracleHeap!)) fail(i, "oracle-heap", `its heap description differs from oracle ${j}'s ${firstDifference(heap, oracleHeap!)}`);
      }
    }
    ++j;
  }
}

// ---------------------------------------------------------------------------------------------------------------------
// The pin comparison (section 11)

// Section 11.2: the oracle run's command line without --jitcache-describe-heap, with the comparison's options last, so
// they override the run's own.
export function pinArguments(context: CommandContext, script: Script, sequence: number, options: string[], paths: SequencePaths, name: string, comparisonOptions: string[]): string[] {
  const args = jscArguments(context, script, sequence, "Off", options, paths, name).filter(arg => !arg.startsWith("--jitcache-describe-heap="));
  // jscArguments ends with <script> -- <role> <scratch> <artifact> <sequence>.
  args.splice(args.length - 6, 0, ...comparisonOptions);
  return args;
}

const comparesWithPin = (session: Session, script: Script) => session.pinSetup !== null && script.host === "jsc" && script.pinOff === null;

// Runs option set j of a sequence with this build's jsc and with the pin's, keeping each side's status, output, error and
// JIT dump as <scratch>/pin<j>.<this|pin>.*, which jitcache-pin-compare.ts reads alone too, and compares them. Each side
// whose build is a twins build runs with --jitcache-test-no-shell-functions, so its global object has the pin shell's
// properties (section 11.2); the side's build decides, not the session's mode, because a twins build registers the shell
// functions in either mode and a plain build rejects the flag.
export async function comparePinOptionSet(setup: PinSetup, script: Script, sequence: number, options: string[], paths: SequencePaths, j: number, stacks: StackSizes | null): Promise<PinComparison> {
  const sides = [
    { side: "this", label: "this build's", build: setup.build, launcher: setup.launcher, extra: setup.pinOptions },
    { side: "pin", label: "the pin's", build: setup.pin, launcher: setup.pinLauncher, extra: [] as string[] },
  ];
  const captures: RunCapture[] = [];
  for (const { side, label, build, launcher, extra } of sides) {
    const name = `pin${j}.${side}`;
    const dumpDirectory = join(paths.scratch, name);
    mkdirSync(dumpDirectory, { recursive: true }); // PerfLog writes its file there and cannot create the directory
    const io: ProcessIO = { env: engineEnvironment(setup.context), cwd: paths.scratch, stdout: join(paths.scratch, `${name}.stdout`), stderr: join(paths.scratch, `${name}.stderr`) };
    const noShellFunctions = build.twins ? ["--jitcache-test-no-shell-functions"] : [];
    const args = pinArguments(setup.context, script, sequence, options, paths, name, [...pinRunOptions(dumpDirectory), ...noShellFunctions, ...extra]);
    const end = await launcher.engine(build.jsc, args, io, stacks);
    if (end.error || end.timedOut) return { difference: { check: "pin-status", detail: `${label} run ${describeEnd(end)}` }, allocations: 0, bodies: 0 };
    const status = { code: end.code, signal: end.signal };
    writeFileSync(join(paths.scratch, `${name}.status`), JSON.stringify(status));
    captures.push({ status, stdout: readBytes(io.stdout), stderr: readText(io.stderr) ?? "", jitDump: readJITDump(dumpDirectory) });
  }
  let engines: [EngineImage, EngineImage];
  try {
    engines = [loadEngineImage(setup.build.jsc), loadEngineImage(setup.pin.jsc)];
  } catch (error) {
    return { difference: { check: "pin-unreadable", detail: (error as Error).message }, allocations: 0, bodies: 0 };
  }
  return compareRuns(setup.build.architecture as Architecture, { capture: captures[0], engine: engines[0] }, { capture: captures[1], engine: engines[1] });
}

// Section 11.2: after the oracle, each option set of its Off runs; the first difference fails the sequence.
async function runPinComparison(session: Session, script: Script, k: number, attempt: number, runs: RunSpec[], paths: SequencePaths, stacks: StackSizes, result: Attempt, fail: Fail) {
  let j = 0;
  for (const { options } of oracleOptionSets(runs)) {
    const comparison = await comparePinOptionSet(session.pinSetup!, script, k, options, paths, j, stacks);
    const { difference } = comparison;
    session.results.write({
      kind: "pin",
      script: script.display,
      sequence: k,
      attempt,
      optionSet: j,
      options,
      outcome: difference ? "different" : "same",
      check: difference?.check ?? null,
      detail: difference?.detail ?? null,
      allocations: comparison.allocations,
      bodies: comparison.bodies,
    });
    if (difference) {
      fail(null, difference.check, `option set ${j} (${options.join(" ") || "no options"}): ${difference.detail}`);
      return;
    }
    ++j;
  }
}

// ---------------------------------------------------------------------------------------------------------------------
// Scripts

async function runSequence(session: Session, script: Script, k: number): Promise<Attempt> {
  const first = await runAttempt(session, script, k, 1);
  const repeats = !first.failures.length && first.marks.length > 0;
  session.results.write(attemptRecord(script, first, repeats ? "repeat" : first.failures.length ? "fail" : "pass"));
  if (!repeats) return first;
  // Section 7.5: a heap coincidence that recurs in fresh processes is a defect, not chance.
  const second = await runAttempt(session, script, k, 2);
  session.results.write(attemptRecord(script, second, second.failures.length ? "fail" : "pass"));
  second.notes.unshift(`repeated after a heap coincidence: ${first.marks.map(mark => `run ${mark.run} ${mark.detail}`).join("; ")}`);
  if (!second.failures.length) rmSync(first.directory, { recursive: true, force: true });
  return second;
}

function attemptRecord(script: Script, attempt: Attempt, outcome: string) {
  return {
    kind: "sequence",
    script: script.display,
    sequence: attempt.sequence,
    attempt: attempt.attempt,
    outcome,
    failures: attempt.failures,
    marks: attempt.marks,
    notes: attempt.notes,
    directory: attempt.directory,
  };
}

async function runScript(session: Session, script: Script) {
  const attempts = await Promise.all(script.sequences.map((_, k) => session.pool.run(() => runSequence(session, script, k))));
  const failures = attempts.flatMap(attempt => attempt.failures);
  // Section 7.5: after the last sequence, every required fault was reported by some run its directive names.
  for (const fault of script.faults.filter(f => f.required)) {
    const reported = attempts.some(attempt => [...attempt.faults].some(([i, steps]) => addresses(fault.at, attempt.sequence, i) && steps.has(fault.step)));
    if (!reported) {
      const at = `${fault.at.sequence === null ? "" : `${fault.at.sequence}:`}${fault.at.run}`;
      failures.push({ sequence: null, attempt: null, run: null, role: null, check: "required-fault", detail: `no run ${at} reported ${fault.step}` });
    }
  }
  for (const attempt of attempts) {
    if (!attempt.failures.length) rmSync(attempt.directory, { recursive: true, force: true });
    else session.keep();
  }
  session.results.write({ kind: "script", script: script.display, outcome: failures.length ? "fail" : "pass", failures });
  if (failures.length) {
    session.failed++;
    console.log(`FAIL ${script.display}`);
    for (const failure of failures) console.log(`  ${describeFailure(failure)}`);
    for (const attempt of attempts.filter(a => a.failures.length)) console.log(`  sequence ${attempt.sequence}: ${attempt.directory}`);
  } else {
    session.passed++;
    console.log(`PASS ${script.display}${script.sequences.length > 1 ? ` (${script.sequences.length} sequences)` : ""}`);
  }
  for (const attempt of attempts) for (const note of attempt.notes) console.log(`  listed: sequence ${attempt.sequence}: ${note}`);
}

function describeFailure(failure: Failure): string {
  const where = [
    failure.sequence === null ? null : `sequence ${failure.sequence}${failure.attempt && failure.attempt > 1 ? ` (attempt ${failure.attempt})` : ""}`,
    failure.run === null ? null : `run ${failure.run} (${failure.role})`,
  ].filter(Boolean);
  return `${where.length ? `${where.join(", ")}: ` : ""}${failure.check}: ${failure.detail}`;
}

// main checked that every path given exists; a lane whose default directory does not exist yet has no script.
function collectScripts(paths: string[]): string[] {
  const scripts: string[] = [];
  for (const path of paths) {
    const status = statSync(path, { throwIfNoEntry: false });
    if (!status) continue;
    if (status.isFile()) {
      scripts.push(path);
      continue;
    }
    // A directory's scripts are its own .js and .mjs files; helpers and checkers sit in subdirectories or have
    // other extensions.
    for (const name of readdirSync(path).sort()) {
      const file = join(path, name);
      if (/\.m?js$/.test(name) && statSync(file).isFile()) scripts.push(file);
    }
  }
  return scripts;
}

async function runScripts(session: Session) {
  const { options } = session;
  const paths = options.testPaths.length ? options.testPaths : lanes.map(lane => join(corpusRoot, lane));
  const runnable: Script[] = [];
  let pinScripts = 0;
  for (const path of collectScripts(paths)) {
    const display = displayPath(path);
    if (options.filter && !options.filter.test(display)) continue;
    let script: Script;
    try {
      script = parseScript(path);
      const problem = bunOptionProblem(script, options.extraOptions);
      if (problem) throw new MalformedScript(problem);
    } catch (error) {
      if (!(error instanceof MalformedScript)) throw error;
      session.failed++;
      const failure: Failure = { sequence: null, attempt: null, run: null, role: null, check: "malformed", detail: error.message };
      session.results.write({ kind: "script", script: display, outcome: "fail", failures: [failure] });
      console.log(`FAIL ${display}\n  malformed: ${error.message}`);
      continue;
    }
    const skip = script.requiresTwins && !session.twins ? "requires twins"
      : script.host === "bun" && !options.bun ? "Bun-hosted, and no --bun names a Bun executable"
      : script.qemuCpu.length && !session.build.emulated ? "declares jitcache-qemu-cpu, so it runs only under QEMU"
      : null;
    if (skip) {
      session.skipped++;
      session.listed.push(`${display}: ${skip}`);
      session.results.write({ kind: "script", script: display, outcome: "skip", reason: skip });
      continue;
    }
    if (script.host === "jsc") {
      // Section 7.2: a script whose Off run cannot run on the pin says why, and the comparison lists it.
      if (session.pinSetup && script.pinOff !== null) session.listed.push(`${display}: the pin comparison skips it: ${script.pinOff}`);
      else pinScripts++;
    }
    runnable.push(script);
  }
  if (!runnable.length) return;
  await session.calibrate();
  await Promise.all(runnable.map(script => runScript(session, script)));
  // Section 7.1: the comparison of the off path with the pin's (section 11) runs only with --pin.
  if (pinScripts && !session.pinSetup) session.listed.push(`the pin comparison of ${pinScripts} jsc-hosted scripts: no --pin names the pin's build`);
}

// ---------------------------------------------------------------------------------------------------------------------
// C++ tests (section 7.8)

async function runCppTests(session: Session) {
  const { build, options } = session;
  if (!statSync(build.testjitcache, { throwIfNoEntry: false })?.isFile()) {
    session.listed.push("the C++ tests: the build has no bin/testjitcache, which only twins builds have");
    return;
  }
  const directory = mkdtempSync(join(session.base, "cpp-"));
  const io = (name: string): ProcessIO => ({ env: { ...process.env }, cwd: directory, stdout: join(directory, `${name}.stdout`), stderr: join(directory, `${name}.stderr`) });
  // A testjitcache process belongs to no sequence, and no twin check compares its heap with another's, so under QEMU each
  // draws its guest stack alone (section 7.9).
  const listing = io("list");
  const listed = await session.launcher.engine(build.testjitcache, ["--list"], listing, null);
  if (listed.error || listed.timedOut || listed.code !== 0) {
    session.failed++;
    session.keep();
    console.log(`FAIL testjitcache --list ${describeEnd(listed)}: ${tail(readText(listing.stderr))}`);
    session.results.write({ kind: "cpp-list", outcome: "fail", detail: describeEnd(listed) });
    return;
  }
  // One "name<TAB>options" line per test; tests with the same options string share a process.
  const groups = new Map<string, { all: string[]; selected: string[] }>();
  for (const line of (readText(listing.stdout) ?? "").split("\n")) {
    if (!line) continue;
    const tab = line.indexOf("\t");
    const [name, group] = tab < 0 ? [line, ""] : [line.slice(0, tab), line.slice(tab + 1)];
    if (!groups.has(group)) groups.set(group, { all: [], selected: [] });
    groups.get(group)!.all.push(name);
    if (!options.filter || options.filter.test(name)) groups.get(group)!.selected.push(name);
  }
  let index = 0;
  const selectedGroups = [...groups].filter(([, { selected }]) => selected.length);
  await Promise.all(selectedGroups.map(([group, { all, selected: names }]) => session.pool.run(async () => {
    // testjitcache filters by substring, so a group the filter splits runs one process per selected test, which may
    // also run the tests whose names contain that name.
    const runs = names.length === all.length ? [[`--group=${group}`]] : names.map(name => [`--group=${group}`, `--filter=${name}`]);
    const failedTests: string[] = [];
    const problems: string[] = [];
    for (const args of runs) {
      const files = io(`group${index++}`);
      const end = await session.launcher.engine(build.testjitcache, args, files, null);
      const output = readText(files.stdout) ?? "";
      failedTests.push(...[...output.matchAll(/^FAIL (\S+)$/gm)].map(match => match[1]));
      if (end.error || end.timedOut || end.code !== 0) {
        const lines = output.split("\n").filter(line => line.startsWith("FAIL ") || line.startsWith("    "));
        problems.push(`${args.join(" ")} ${describeEnd(end)}${lines.length ? `\n${lines.join("\n")}` : `: ${tail(readText(files.stderr))}`}`);
      }
    }
    session.results.write({ kind: "cpp-group", options: group, tests: names, outcome: problems.length ? "fail" : "pass", failedTests, problems });
    if (problems.length) {
      session.failed++;
      session.keep();
      console.log(`FAIL testjitcache group "${group}"`);
      for (const problem of problems) console.log(problem.replace(/^/gm, "  "));
    } else {
      session.passed++;
      console.log(`PASS testjitcache group "${group}" (${names.length} tests)`);
    }
  })));
}

// ---------------------------------------------------------------------------------------------------------------------
// The bench mode (section 9.4)

// The values installationBoundSmallestBody may take, in bytes of the installed image's linked size, the install event's
// image.codeSize (SPEC-integrator.md section 16).
export const smallestBodyCandidates = [0, 128, 256, 512, 1024, 2048, 4096];

// Section 9.2's flush events carry the process's totals so far, so the last line of each holds the whole run; every
// other event is written once per occurrence.
const flushEvents = new Set(["lookup", "index", "budget", "process"]);

// The fields of section 9.2 that hold thread CPU time (section 9.1), by event: the only spans the bench takes a minimum
// and a median of, since the minimum filters interference, which only lengthens a span. Every other field is reported
// by copy: a count, size, score or flag has no interference to filter, and a wall time, such as the install steps', only
// explains a CPU-time span.
const cpuTimeFields: Record<string, (field: string) => boolean> = {
  start: field => field === "nanoseconds",
  open: field => field === "nanoseconds",
  lookup: field => field.endsWith(".nanoseconds"),
  request: field => field === "counted" || field === "apart",
  install: field => field === "total" || field === "bodyRelease",
  compile: field => field === "compileNanoseconds" || field === "finalizeNanoseconds",
  capture: field => /^(scoring|build)\./.test(field) || /^writer\.(.+\.stream|reread|publish)$/.test(field),
  delta: field => field === "phase1Nanoseconds" || field === "phase2Nanoseconds",
};

export const isCPUTime = (span: string) => {
  const dot = span.indexOf(".");
  return dot > 0 && !span.includes("=") && (cpuTimeFields[span.slice(0, dot)]?.(span.slice(dot + 1)) ?? false);
};

class BenchError extends Error {}

export type BenchEvent = Record<string, unknown> & { event: string };

export function readBenchReport(path: string): { events: BenchEvent[]; unreadable: number } {
  const events: BenchEvent[] = [];
  let unreadable = 0;
  for (const line of (readText(path) ?? "").split("\n")) {
    if (!line) continue;
    try {
      const event = JSON.parse(line);
      if (typeof event?.event === "string") events.push(event);
      else ++unreadable;
    } catch {
      ++unreadable;
    }
  }
  return { events, unreadable };
}

// One process's spans. An occurrence event gives its count and, for each field, the sum of its numbers, the number of
// events where a boolean holds, or the number of events with each value of a string, named <event>.<field>=<value>. A
// flush event gives the fields of its last line. Keys are left out; the installation bound joins by them (below).
export function processSpans(events: BenchEvent[]): Map<string, number> {
  const spans = new Map<string, number>();
  const add = (name: string, value: number) => spans.set(name, (spans.get(name) ?? 0) + value);
  const fields = (event: BenchEvent) => Object.entries(event).filter(([field]) => !["event", "pid", "vm", "key"].includes(field));
  const lastFlush = new Map<string, BenchEvent>();
  for (const event of events) {
    if (flushEvents.has(event.event)) {
      lastFlush.set(event.event, event);
      continue;
    }
    add(`${event.event}.count`, 1);
    for (const [field, value] of fields(event)) {
      if (typeof value === "number") add(`${event.event}.${field}`, value);
      else if (typeof value === "boolean") add(`${event.event}.${field}`, value ? 1 : 0);
      else if (typeof value === "string") add(`${event.event}.${field}=${value}`, 1);
    }
  }
  for (const [name, event] of lastFlush) {
    for (const [field, value] of fields(event)) {
      if (typeof value === "number" || typeof value === "boolean") spans.set(`${name}.${field}`, Number(value));
    }
  }
  return spans;
}

export interface SpanSummary {
  min: number;
  median: number;
  n: number; // the copies that measured the span
  values: (number | null)[]; // each copy's value, null where it measured none
}

export function median(values: number[]): number {
  const sorted = [...values].sort((a, b) => a - b);
  const middle = sorted.length >> 1;
  return sorted.length % 2 ? sorted[middle] : (sorted[middle - 1] + sorted[middle]) / 2;
}

function summarize(values: (number | null)[]): SpanSummary | null {
  const measured = values.filter((value): value is number => value !== null);
  return measured.length ? { min: Math.min(...measured), median: median(measured), n: measured.length, values } : null;
}

// A run's spans by copy, from each copy's spans, or null for a copy that wrote no bench report or was dropped. An
// occurrence event's span is 0 in a copy whose report lacks the event, since that copy's count and sums are 0; a flush
// event's span is measured only in the copies that wrote it.
export function spansByCopy(copies: (Map<string, number> | null)[]): Map<string, (number | null)[]> {
  const names = [...new Set(copies.flatMap(spans => (spans ? [...spans.keys()] : [])))].sort();
  const byCopy = new Map<string, (number | null)[]>();
  for (const name of names) {
    const flush = flushEvents.has(name.slice(0, name.indexOf(".")));
    byCopy.set(name, copies.map(spans => (spans ? (spans.get(name) ?? (flush ? null : 0)) : null)));
  }
  return byCopy;
}

// The installation bound (SPEC-integrator.md IB3). A body's import cost is its import or seed request's counted total
// plus its install's total, joined by key with a request that came before the install in its process; its native cost
// is its compile event's compilation plus finalization in the native copies, whose artifact holds no body and whose role
// records nothing. An import takes the place of a body's first compilation, so a process gives a body at most one sample
// per side: on the import side its first install, on the native side its first compile. A sample whose compile or
// install generated per-VM support does not count, and a body left with no counting sample on a side is set aside.

interface ImportSample {
  nanoseconds: number; // request + install
  request: number; // the request event's counted total
  install: number; // the install event's total, the install function's thread CPU time
  action: string; // import or seed
  imageCodeSize: number; // the image's linked size
  allocation: number; // the installed code's executable allocation, the install event's codeSize
  fixups: number; // the image's fixup count
  steps: Record<string, number>; // the install's steps that ran, wall time that explains the total (section 9.1)
}

interface NativeSample {
  nanoseconds: number; // compile + finalize
  compile: number;
  finalize: number;
  allocation: number; // the native code's executable allocation, the compile event's codeSize
}

export interface BodyTally {
  key: string;
  importSamples: ImportSample[];
  nativeSamples: NativeSample[];
  installSupportGenerated: number;
  installWithoutRequest: number; // installs that no import or seed request of the key preceded in their process
  compileSupportGenerated: number;
  supportGeneratedNanoseconds: number[]; // the native compiles that generated support, which only the whole native cost counts
  requestedWithoutInstall: number; // import-side processes that imported the body and never installed it
  compiledOnImportSide: number; // import-side processes that compiled the body natively
  firstImageCodeSize: number | null; // the first install's image.codeSize, the size of a body without a counting import sample
  imageCodeSizes: Set<number>; // the image.codeSize of each process's install
}

const numberField = (event: BenchEvent, field: string) => (typeof event[field] === "number" ? (event[field] as number) : 0);

function tallyOf(tallies: Map<string, BodyTally>, key: string): BodyTally {
  let tally = tallies.get(key);
  if (!tally) {
    tally = {
      key,
      importSamples: [],
      nativeSamples: [],
      installSupportGenerated: 0,
      installWithoutRequest: 0,
      compileSupportGenerated: 0,
      supportGeneratedNanoseconds: [],
      requestedWithoutInstall: 0,
      compiledOnImportSide: 0,
      firstImageCodeSize: null,
      imageCodeSizes: new Set(),
    };
    tallies.set(key, tally);
  }
  return tally;
}

function firstByKey(events: BenchEvent[], test: (event: BenchEvent) => boolean): Map<string, BenchEvent> {
  const first = new Map<string, BenchEvent>();
  for (const event of events) {
    if (typeof event.key === "string" && test(event) && !first.has(event.key)) first.set(event.key, event);
  }
  return first;
}

// One import-side process of a Consumer run. Its events come in the order the process wrote them, so an install joins
// only a request written before it.
export function addImportSide(tallies: Map<string, BodyTally>, events: BenchEvent[]) {
  const requests = new Map<string, BenchEvent>(); // each key's first import or seed request so far
  const installed = new Set<string>();
  for (const event of events) {
    const key = event.key;
    if (typeof key !== "string") continue;
    if (event.event === "request" && (event.action === "import" || event.action === "seed")) {
      if (!requests.has(key)) requests.set(key, event);
      continue;
    }
    if (event.event !== "install" || installed.has(key)) continue;
    installed.add(key);
    const tally = tallyOf(tallies, key);
    const imageCodeSize = numberField(event, "image.codeSize");
    tally.firstImageCodeSize ??= imageCodeSize;
    tally.imageCodeSizes.add(imageCodeSize);
    if (event.supportGenerated === true) {
      ++tally.installSupportGenerated;
      continue;
    }
    const request = requests.get(key);
    if (!request) {
      ++tally.installWithoutRequest;
      continue;
    }
    const steps: Record<string, number> = {};
    for (const [field, value] of Object.entries(event)) {
      if (field.startsWith("steps.") && typeof value === "number") steps[field.slice("steps.".length)] = value;
    }
    const requestNanoseconds = numberField(request, "counted");
    const installNanoseconds = numberField(event, "total");
    tally.importSamples.push({
      nanoseconds: requestNanoseconds + installNanoseconds,
      request: requestNanoseconds,
      install: installNanoseconds,
      action: String(request.action),
      imageCodeSize,
      allocation: numberField(event, "codeSize"),
      fixups: numberField(event, "image.fixupCount"),
      steps,
    });
  }
  for (const key of requests.keys()) {
    if (!installed.has(key)) ++tallyOf(tallies, key).requestedWithoutInstall;
  }
  for (const key of firstByKey(events, event => event.event === "compile").keys()) ++tallyOf(tallies, key).compiledOnImportSide;
}

// One native copy. Returns its compiles without a key, whose UCB the parent-key registry did not hold, and the
// compilation and finalization time of every compile it made, the copy's whole native cost.
export function addNativeSide(tallies: Map<string, BodyTally>, events: BenchEvent[]): { keyless: number; nanoseconds: number } {
  const time = (compile: BenchEvent) => numberField(compile, "compileNanoseconds") + numberField(compile, "finalizeNanoseconds");
  for (const [key, compile] of firstByKey(events, event => event.event === "compile")) {
    const tally = tallyOf(tallies, key);
    if (compile.supportGenerated === true) {
      ++tally.compileSupportGenerated;
      tally.supportGeneratedNanoseconds.push(time(compile));
      continue;
    }
    tally.nativeSamples.push({ nanoseconds: time(compile), compile: numberField(compile, "compileNanoseconds"), finalize: numberField(compile, "finalizeNanoseconds"), allocation: numberField(compile, "codeSize") });
  }
  const compiles = events.filter(event => event.event === "compile");
  return { keyless: compiles.filter(compile => compile.key === null).length, nanoseconds: compiles.reduce((sum, compile) => sum + time(compile), 0) };
}

export type BodyStatus = "joined" | "set aside" | "native only" | "import only";

// Why a side has no counting sample: per-VM support generated in each of its samples (IB3), or installs that no import
// or seed request preceded, as an attach's.
interface SetAside {
  side: "import" | "native";
  reason: "supportGenerated" | "installWithoutImportRequest";
  samples: number;
}

interface SideValue<Sample> {
  samples: number; // the counting ones
  min: number | null;
  median: number | null;
  minimum: Sample | null; // the sample that gave the minimum
}

export interface BoundBody {
  key: string;
  status: BodyStatus;
  // The installed image's linked size, which installationBoundSmallestBody reads: the size in the sample that gave the
  // import minimum, or the first install's for a body without a counting import sample.
  imageCodeSize: number | null;
  imageCodeSizeVaries: boolean; // the installs of different copies reported different sizes
  installedAllocation: number | null; // the executable allocation in the sample that gave the import minimum
  nativeAllocation: number | null; // the one in the sample that gave the native minimum, which may differ
  ratio: number | null; // the import minimum over the native minimum
  // The body's part of the whole native cost: its native minimum, or for a body set aside on the native side, the least
  // time of its compiles that generated support.
  nativeCost: number | null;
  import: SideValue<ImportSample> & { supportGenerated: number; withoutImportRequest: number; requestedWithoutInstall: number; compiledNatively: number };
  native: SideValue<NativeSample> & { supportGenerated: number };
  setAside: SetAside[];
}

function sideValue<Sample extends { nanoseconds: number }>(samples: Sample[]): SideValue<Sample> {
  if (!samples.length) return { samples: 0, min: null, median: null, minimum: null };
  const minimum = samples.reduce((least, sample) => (sample.nanoseconds < least.nanoseconds ? sample : least));
  return { samples: samples.length, min: minimum.nanoseconds, median: median(samples.map(sample => sample.nanoseconds)), minimum };
}

export function boundBody(tally: BodyTally): BoundBody {
  const imported = sideValue(tally.importSamples);
  const compiled = sideValue(tally.nativeSamples);
  const setAside: SetAside[] = [];
  if (!imported.samples) {
    if (tally.installSupportGenerated) setAside.push({ side: "import", reason: "supportGenerated", samples: tally.installSupportGenerated });
    if (tally.installWithoutRequest) setAside.push({ side: "import", reason: "installWithoutImportRequest", samples: tally.installWithoutRequest });
  }
  if (!compiled.samples && tally.compileSupportGenerated) setAside.push({ side: "native", reason: "supportGenerated", samples: tally.compileSupportGenerated });
  const status: BodyStatus = imported.samples && compiled.samples ? "joined" : setAside.length ? "set aside" : compiled.samples ? "native only" : "import only";
  return {
    key: tally.key,
    status,
    imageCodeSize: imported.minimum ? imported.minimum.imageCodeSize : tally.firstImageCodeSize,
    imageCodeSizeVaries: tally.imageCodeSizes.size > 1,
    installedAllocation: imported.minimum?.allocation ?? null,
    nativeAllocation: compiled.minimum?.allocation ?? null,
    ratio: status === "joined" && compiled.min ? imported.min! / compiled.min : null,
    nativeCost: compiled.min ?? (tally.supportGeneratedNanoseconds.length ? Math.min(...tally.supportGeneratedNanoseconds) : null),
    import: {
      ...imported,
      supportGenerated: tally.installSupportGenerated,
      withoutImportRequest: tally.installWithoutRequest,
      requestedWithoutInstall: tally.requestedWithoutInstall,
      compiledNatively: tally.compiledOnImportSide,
    },
    native: { ...compiled, supportGenerated: tally.compileSupportGenerated },
    setAside,
  };
}

export interface BoundCoverage {
  script: string | null; // null for every script together
  smallestBody: number;
  covered: number; // the joined bodies of at least S
  nativeShare: number | null; // their native cost over the whole native cost
  excludedShare: number | null; // the native cost of the bodies smaller than S, joined or set aside, over the whole
  p50: number | null; // nearest-rank percentiles of the covered bodies' ratios
  p99: number | null;
  max: number | null;
}

const percentile = (sorted: number[], p: number) => (sorted.length ? sorted[Math.ceil((p / 100) * sorted.length) - 1] : null);

// The joined bodies a smallest body S covers, those whose image size is at least S, and their ratios, against the whole
// native cost of the runs the bodies come from: every compile their native copies made, set-aside and keyless ones
// included, as the bound's rule reads a workload's whole native compile time.
export function boundCoverage(bodies: BoundBody[], wholeNativeCost: number, smallestBody: number, script: string | null): BoundCoverage {
  const covered = bodies.filter(body => body.status === "joined" && body.imageCodeSize! >= smallestBody);
  const excluded = bodies.filter(body => body.imageCodeSize !== null && body.imageCodeSize < smallestBody);
  const nativeCost = (list: BoundBody[]) => list.reduce((total, body) => total + (body.nativeCost ?? 0), 0);
  const ratios = covered.map(body => body.ratio!).sort((a, b) => a - b);
  return {
    script,
    smallestBody,
    covered: covered.length,
    nativeShare: wholeNativeCost ? nativeCost(covered) / wholeNativeCost : null,
    excludedShare: wholeNativeCost ? nativeCost(excluded) / wholeNativeCost : null,
    p50: percentile(ratios, 50),
    p99: percentile(ratios, 99),
    max: ratios.length ? ratios[ratios.length - 1] : null,
  };
}

// The Consumer runs whose bodies enter the coverage: those whose options leave both sides' work as the bench measures it,
// so none beyond JITCache's own flags, --useConcurrentJIT and --diskCachePath. --verboseOSR, for one, logs inside the
// native finalize span, and --collectContinuously adds collections to both sides.
export const coversRun = (options: string[]) =>
  options.every(option => option.startsWith("--jitcache") || ["--useConcurrentJIT", "--diskCachePath"].includes(flagName(option)));

// build.ts's lock, which every build holds while it runs.
const buildLockPath = () => resolve(process.env.XDG_CACHE_HOME || join(homedir(), ".cache"), "jitcache", "build.lock");

interface HeldLock {
  readonly lost: boolean; // the holder exited before the release, and the lock with it
  release(): Promise<void>;
}

// HARNESS.md, Benches: the bench holds the build lock for its whole duration, so no build or other bench overlaps it. A
// flock process holds it, as build.ts takes it, until the runner closes that process's standard input or exits.
async function holdBuildLock(path: string): Promise<HeldLock> {
  mkdirSync(dirname(path), { recursive: true });
  for (const blocking of [false, true]) {
    if (blocking) console.log(`waiting for the build lock ${path}, which a build or another bench holds`);
    const holder = spawn("flock", ["--exclusive", ...(blocking ? [] : ["--nonblock"]), path, "sh", "-c", "echo held && exec cat >/dev/null"], { stdio: ["pipe", "pipe", "inherit"] });
    let releasing = false;
    let lost = false;
    const closed = new Promise<void>(done => holder.on("close", () => {
      if (!releasing) lost = true;
      done();
    }));
    const held = await new Promise<boolean>(done => {
      let output = "";
      holder.stdout!.on("data", chunk => {
        output += chunk;
        if (output.includes("held\n")) done(true);
      });
      holder.on("error", () => done(false));
      holder.on("close", () => done(false));
    });
    if (!held) continue;
    return {
      get lost() {
        return lost;
      },
      async release() {
        releasing = true;
        holder.stdin!.end();
        await closed;
      },
    };
  }
  throw new BenchError(`flock could not take the build lock ${path}`);
}

// Whether the build's times mean anything: a release build without ASan or the twins checks, as release-local is.
function benchProfile(build: Build): { name: string; buildType: string; warning: string | null } {
  const cache = readText(join(build.directory, "CMakeCache.txt")) ?? "";
  const buildType = /^CMAKE_BUILD_TYPE:[A-Z]+=(.*)$/m.exec(cache)?.[1]?.trim() || "unknown";
  const name = basename(resolve(build.directory, "../.."));
  const reasons = [
    buildType === "Debug" || buildType === "unknown" ? `of build type ${buildType}` : null,
    build.sanitized ? "built with ASan" : null,
    build.twins ? "a twins build" : null,
  ].filter(Boolean);
  const warning = reasons.length ? `${build.directory} is ${reasons.join(", ")}, so its bench numbers mean nothing; the bench measures a release-local build` : null;
  return { name, buildType, warning };
}

// The bench measures plain mode's command lines with strict at its default (THREAD Verification), so no JSC_ variable
// reaches its processes, which would add options nobody sees. A run whose exit status the bench reads keeps it under
// ASan, as section 7.5's runs do; a build without ASan ignores those variables.
function benchEnvironment(judged: boolean): ProcessIO["env"] {
  const env = Object.fromEntries(Object.entries(process.env).filter(([name]) => !name.startsWith("JSC_")));
  return judged ? keepingExitStatus(env) : env;
}

// Section 9.4: the plain-mode command line of section 7.3 with strict at its default, off, so the runner's
// --jitcache-strict=1 goes, and with the bench report right after --jitcache-log. The run's own options still come last.
export function benchArguments(context: CommandContext, script: Script, sequence: number, role: Role, options: string[], paths: SequencePaths, name: string, report: string): string[] {
  const args = jscArguments(context, script, sequence, role, options, paths, name);
  if (!configuresJITCache(role)) return args;
  const strict = args.indexOf("--jitcache-strict=1");
  if (strict < 0 || args[strict + 1] !== "--jitcache-log") throw new Error("jscArguments no longer writes --jitcache-strict=1 --jitcache-log");
  args.splice(strict, 2, "--jitcache-log", `--jitcache-bench-report=${report}`);
  return args;
}

interface RunProblem {
  copy: number;
  problem: string;
}

type Side = "import" | "native";

// One run of a sequence on one side over the bench's copies. The import side is the run as its sequence gives it; a
// Consumer run that jitcache-expect-no-install does not name also has a native side, its native copies.
interface RunMeasures {
  script: Script;
  sequence: number;
  run: number;
  side: Side;
  spans: (Map<string, number> | null)[]; // by copy, null for a copy that wrote no bench report or was dropped
  wallMilliseconds: (number | null)[];
  problems: RunProblem[];
  dropped: number; // the copies a problem in this run, or earlier in its copy, kept out
}

interface RunBound {
  script: Script;
  sequence: number;
  run: number;
  options: string[];
  covered: boolean; // coversRun: the run's bodies enter the coverage
  tallies: Map<string, BodyTally>;
  keylessCompiles: number;
  nativeNanoseconds: (number | null)[]; // by copy, every compile's time in the native copy
}

// A Consumer run that may install has native copies; one jitcache-expect-no-install names has nothing to join.
const hasNativeCopies = (script: Script, k: number, i: number) =>
  script.sequences[k][i].role === "Consumer" && !script.expectNoInstall.some(at => addresses(at, k, i));

// One invocation of the bench mode. Its command context is plain mode's, without --extra-options or the calibration's
// variable, and it gathers every run's measures and every Consumer run's bound by copy.
class Bench implements CommandContext {
  readonly twins = false;
  readonly extraOptions: string[] = [];
  readonly mallocForceEnabled = false;
  readonly launcher: Launcher;
  readonly base: string; // the bench's temporary directory
  readonly results: ResultsLog;
  readonly nativeArtifact: string;
  readonly runs = new Map<string, RunMeasures>();
  readonly bounds = new Map<string, RunBound>();
  readonly listed: string[] = [];
  readonly malformed: string[] = [];
  processes = 0;
  kept = false;

  constructor(readonly options: RunnerOptions, readonly build: Build) {
    this.launcher = new Launcher(build, options.timeoutSeconds, "max");
    this.base = mkdtempSync(join(tmpdir(), "jitcache-bench-"));
    this.results = new ResultsLog(build.resultsDirectory, this.base, "bench-");
    this.nativeArtifact = join(this.base, "native", "artifact");
  }

  measures(script: Script, sequence: number, run: number, side: Side): RunMeasures {
    const key = `${script.path}\0${sequence}\0${run}\0${side}`;
    let measures = this.runs.get(key);
    if (!measures) {
      const copies = this.options.benchProcesses;
      measures = { script, sequence, run, side, spans: Array(copies).fill(null), wallMilliseconds: Array(copies).fill(null), problems: [], dropped: 0 };
      this.runs.set(key, measures);
    }
    return measures;
  }

  bound(script: Script, sequence: number, run: number): RunBound {
    const key = `${script.path}\0${sequence}\0${run}`;
    let bound = this.bounds.get(key);
    if (!bound) {
      const options = script.sequences[sequence][run].options;
      bound = { script, sequence, run, options, covered: coversRun(options), tallies: new Map(), keylessCompiles: 0, nativeNanoseconds: Array(this.options.benchProcesses).fill(null) };
      this.bounds.set(key, bound);
    }
    return bound;
  }

  // Every run's sides of a script, in the order a copy runs them, each with its measures, so every run has a line even
  // when no copy reached it.
  sides(script: Script, sequence: number): { run: number; side: Side; measures: RunMeasures }[] {
    return script.sequences[sequence].flatMap((_, run) => (hasNativeCopies(script, sequence, run) ? (["import", "native"] as Side[]) : (["import"] as Side[]))
      .map(side => ({ run, side, measures: this.measures(script, sequence, run, side) })));
  }
}

// The scripts plain mode runs, jsc-hosted. Every other script is listed, and a malformed one counts against the bench.
function benchScripts(bench: Bench): Script[] {
  const { options } = bench;
  const paths = options.testPaths.length ? options.testPaths : lanes.map(lane => join(corpusRoot, lane));
  const scripts: Script[] = [];
  for (const path of collectScripts(paths)) {
    const display = displayPath(path);
    if (options.filter && !options.filter.test(display)) continue;
    let script: Script;
    try {
      script = parseScript(path);
    } catch (error) {
      if (!(error instanceof MalformedScript)) throw error;
      bench.malformed.push(`${display}: ${error.message}`);
      bench.results.write({ kind: "bench-script", script: display, outcome: "malformed", reason: error.message });
      continue;
    }
    const skip = script.requiresTwins ? "requires twins"
      : script.host === "bun" ? "Bun-hosted, and the bench measures jsc-hosted scripts only; the macro benches measure Bun"
      : script.qemuCpu.length ? "declares jitcache-qemu-cpu, so it runs only under QEMU"
      : null;
    if (skip) {
      bench.listed.push(`${display}: ${skip}`);
      bench.results.write({ kind: "bench-script", script: display, outcome: "skip", reason: skip });
      continue;
    }
    scripts.push(script);
  }
  return scripts;
}

// The native copies' artifact: a Producer run of an empty script, which compiles nothing and so commits no body. Every
// native copy opens it as a Consumer and checks that it still indexes no body.
async function createNativeArtifact(bench: Bench) {
  const directory = dirname(bench.nativeArtifact);
  mkdirSync(bench.nativeArtifact, { recursive: true });
  const report = join(directory, "producer.bench");
  const io: ProcessIO = { env: benchEnvironment(true), cwd: directory, stdout: join(directory, "producer.stdout"), stderr: join(directory, "producer.stderr") };
  const args = ["--destroy-vm", `--jitcache=${bench.nativeArtifact}`, "--jitcache-mode=p", "--jitcache-log", `--jitcache-bench-report=${report}`, "-e", ""];
  const end = await bench.launcher.engine(bench.build.jsc, args, io, null);
  ++bench.processes;
  const start = readBenchReport(report).events.find(event => event.event === "start");
  const exit = exitProblem(end, 0);
  if (exit || start?.outcome !== "started" || start.role !== "producer") {
    bench.kept = true;
    throw new BenchError(`the Producer that creates the native copies' artifact ${exit ?? `started ${start ? `${start.outcome} as ${start.role}` : "without a start event"}`}: ${tail(readText(io.stderr))}`);
  }
}

// One copy of a sequence, in a fresh directory: each run in order, and right after a Consumer run with native copies
// its native copy, which starts from a copy of the scratch directory the run started from, so it reads what the run
// read, such as the shell's bytecode cache, and writes nothing the sequence's later runs read. The copy stops at its
// first problem: what follows builds on a run that failed, so the copy contributes nothing from that run on.
async function runBenchCopy(bench: Bench, script: Script, k: number, copy: number) {
  const directory = mkdtempSync(join(bench.base, `${script.display.replace(/[^\w.-]+/g, "_")}.s${k}.c${copy}-`));
  const paths: SequencePaths = { artifact: join(directory, "artifact"), scratch: join(directory, "scratch"), layouts: [] };
  mkdirSync(paths.artifact);
  mkdirSync(paths.scratch);
  let stopped = false;
  for (const { run, side, measures } of bench.sides(script, k)) {
    if (stopped) {
      ++measures.dropped;
      continue;
    }
    const native: SequencePaths = { artifact: bench.nativeArtifact, scratch: join(directory, `native${run}`), layouts: [] };
    if (side === "import" && hasNativeCopies(script, k, run)) cpSync(paths.scratch, native.scratch, { recursive: true });
    if (!(await benchRun(bench, measures, copy, side === "import" ? paths : native))) {
      ++measures.dropped;
      stopped = true;
    }
  }
  if (stopped) {
    bench.kept = true;
    console.log(`  kept ${directory}`);
  } else {
    rmSync(directory, { recursive: true, force: true });
  }
}

// One process of a copy; returns whether it passed its checks, and only then records its spans and bound samples. Its
// checks are section 7.5's exit and final-status checks, without the install check for a native copy, whose artifact
// holds no body, plus the bench report's own: a start event in every run with JITCache and, in a native copy, a Consumer
// start on an artifact that indexes no body.
async function benchRun(bench: Bench, measures: RunMeasures, copy: number, paths: SequencePaths): Promise<boolean> {
  const { script, sequence: k, run: i, side } = measures;
  const run = script.sequences[k][i];
  const name = `run${i}`;
  const report = join(paths.scratch, `${name}.bench`);
  const expected = expectedExit(script, k, i);
  const io: ProcessIO = { env: benchEnvironment(!endsBySignal(expected)), cwd: paths.scratch, stdout: join(paths.scratch, `${name}.stdout`), stderr: join(paths.scratch, `${name}.stderr`) };
  const args = run.role === "Maintenance"
    ? ["--jitcache-maintenance", "--", ...run.options.map(word => word.replaceAll("$ARTIFACT", paths.artifact))]
    : benchArguments(bench, script, k, run.role, run.options, paths, name, report);
  const started = performance.now();
  const end = await bench.launcher.engine(bench.build.jsc, args, io, null);
  const wallMilliseconds = performance.now() - started;
  ++bench.processes;

  const problems: string[] = [];
  const exit = exitProblem(end, expected);
  if (exit) problems.push(exit);
  const { events, unreadable } = configuresJITCache(run.role) ? readBenchReport(report) : { events: [], unreadable: 0 };
  if (configuresJITCache(run.role)) {
    if (unreadable) problems.push(`${unreadable} lines of its bench report are no event`);
    const start = events.find(event => event.event === "start");
    if (!start && !endsBySignal(expected)) problems.push("its bench report holds no start event");
    if (start && side === "native" && (start.outcome !== "started" || start.role !== "consumer" || start.indexedBodies !== 0))
      problems.push(`the native copy started ${start.outcome} as ${start.role} on an artifact of ${start.indexedBodies} bodies, where it must start as a consumer of an empty one`);
    if (!endsBySignal(expected)) {
      const checked = side === "native" ? { ...script, expectNoInstall: [...script.expectNoInstall, { sequence: k, run: i }] } : script;
      const attempt: Attempt = { sequence: k, attempt: 1, directory: paths.scratch, failures: [], marks: [], notes: [], faults: new Map() };
      checkStatuses(checked, k, i, run, readText(io.stderr) ?? "", attempt, (_, check, detail) => problems.push(`${check}: ${detail}`));
    }
  }
  if (problems.length) {
    measures.problems.push(...problems.map(problem => ({ copy, problem })));
    return false;
  }
  measures.wallMilliseconds[copy] = wallMilliseconds;
  if (events.length) measures.spans[copy] = processSpans(events);
  if (hasNativeCopies(script, k, i)) {
    const bound = bench.bound(script, k, i);
    if (side === "import") {
      addImportSide(bound.tallies, events);
    } else {
      const { keyless, nanoseconds } = addNativeSide(bound.tallies, events);
      bound.keylessCompiles += keyless;
      bound.nativeNanoseconds[copy] = nanoseconds;
    }
  }
  return true;
}

const loadText = (load: number[] | null) => (load ? load.map(value => value.toFixed(2)).join(" ") : "unknown");
const ratioText = (ratio: number | null) => (ratio === null ? "n/a" : ratio.toFixed(3));
const percentText = (share: number | null) => (share === null ? "n/a" : `${(100 * share).toFixed(1)}%`);

// A run's line: its CPU-time spans with their minimum and median beside every copy's value, and every other field, the
// process's memory and its wall time by copy.
function runRecord(measures: RunMeasures) {
  const spans: Record<string, SpanSummary> = {};
  const fields: Record<string, (number | null)[]> = {};
  const memory: Record<string, (number | null)[]> = {};
  for (const [name, values] of spansByCopy(measures.spans)) {
    if (name.startsWith("process.")) memory[name.slice("process.".length)] = values;
    else if (isCPUTime(name)) spans[name] = summarize(values)!;
    else fields[name] = values;
  }
  const run = measures.script.sequences[measures.sequence][measures.run];
  return {
    kind: "bench-run",
    script: measures.script.display,
    sequence: measures.sequence,
    run: measures.run,
    role: run.role,
    side: measures.side,
    options: run.options,
    copies: measures.spans.length,
    dropped: measures.dropped,
    spans,
    fields,
    memory,
    wallMilliseconds: measures.wallMilliseconds,
    problems: measures.problems,
  };
}

// The whole native cost of a run, the least over its native copies of every compile's time; 0 without a native copy.
const wholeNativeCost = (bound: RunBound) => {
  const totals = bound.nativeNanoseconds.filter((value): value is number => value !== null);
  return totals.length ? Math.min(...totals) : 0;
};

// Section 9.4's command line: every copy of every sequence, then the results file's lines and the summary. Returns the
// exit code.
export async function runBench(options: RunnerOptions, build: Build): Promise<number> {
  const bench = new Bench(options, build);
  const profile = benchProfile(build);
  const copies = options.benchProcesses;
  const started = performance.now();
  console.log(`bench of ${build.directory} (${profile.name}, ${profile.buildType}): ${copies} copies of each sequence`);
  if (profile.warning) console.log(`warning: ${profile.warning}`);
  bench.results.write({
    kind: "bench",
    date: new Date().toISOString(),
    build: { directory: build.directory, profile: profile.name, buildType: profile.buildType, architecture: build.architecture, twins: build.twins, sanitized: build.sanitized },
    machine: { cpus: cpus().length, model: cpus()[0]?.model ?? null, memoryBytes: totalmem(), kernel: release() },
    copies,
    warning: profile.warning,
  });
  const scripts = benchScripts(bench);
  const loadAverage: { before: number[] | null; copies: number[][]; after: number[] | null } = { before: null, copies: [], after: null };
  let error: string | null = null;
  let lock: HeldLock | null = null;
  let lockLost = false;
  try {
    if (!scripts.length) throw new BenchError("no script of the test paths runs in plain mode in jsc");
    lock = await holdBuildLock(buildLockPath());
    loadAverage.before = loadavg();
    await createNativeArtifact(bench);
    const sequences = scripts.reduce((sum, script) => sum + script.sequences.length, 0);
    console.log(`${scripts.length} scripts, ${sequences} sequences, under the build lock; load average ${loadText(loadAverage.before)}`);
    // Copy n of every sequence runs before copy n + 1 of any, so a slow spell of the machine reaches few copies of each
    // case and the minimum holds.
    for (let copy = 0; copy < copies; ++copy) {
      const copyStarted = performance.now();
      for (const script of scripts) {
        for (let k = 0; k < script.sequences.length; ++k) await runBenchCopy(bench, script, k, copy);
      }
      loadAverage.copies.push(loadavg());
      console.log(`copy ${copy + 1} of ${copies}: ${((performance.now() - copyStarted) / 1000).toFixed(0)} s, load average ${loadText(loadAverage.copies[copy])}`);
    }
    loadAverage.after = loadavg();
  } catch (caught) {
    if (!(caught instanceof BenchError)) throw caught;
    error = caught.message;
  } finally {
    // A holder that exited before the release took the lock with it, so a build may have overlapped the bench.
    if (lock) {
      lockLost = lock.lost;
      await lock.release();
    }
  }

  // A script counts as measured once a process of it ran, so a bench that stopped before its copies measured none.
  const measured = new Map<Script, number>();
  for (const measures of bench.runs.values()) measured.set(measures.script, (measured.get(measures.script) ?? 0) + measures.problems.length);
  for (const [script, problems] of measured) bench.results.write({ kind: "bench-script", script: script.display, outcome: "measured", sequences: script.sequences.length, problems });
  const records = [...bench.runs.values()].map(runRecord);
  for (const record of records) bench.results.write(record);
  const bodies = [...bench.bounds.values()].flatMap(bound => [...bound.tallies.values()].map(tally => ({ bound, body: boundBody(tally) })));
  for (const { bound, body } of bodies) {
    bench.results.write({ kind: "bound-body", script: bound.script.display, sequence: bound.sequence, run: bound.run, options: bound.options, inCoverage: bound.covered, ...body });
  }
  // Coverage over every script and over each, from the runs coversRun admits.
  const covered = [...bench.bounds.values()].filter(bound => bound.covered);
  const scopes: [string | null, RunBound[]][] = [[null, covered], ...[...new Set(covered.map(bound => bound.script))].map(script => [script.display, covered.filter(bound => bound.script === script)] as [string, RunBound[]])];
  const coverage = scopes.flatMap(([script, bounds]) => {
    const scopeBodies = bodies.filter(({ bound }) => bounds.includes(bound)).map(({ body }) => body);
    const whole = bounds.reduce((sum, bound) => sum + wholeNativeCost(bound), 0);
    return smallestBodyCandidates.map(smallestBody => boundCoverage(scopeBodies, whole, smallestBody, script));
  });
  for (const row of coverage) bench.results.write({ kind: "bound-coverage", ...row });
  const statuses = Object.fromEntries((["joined", "set aside", "native only", "import only"] as BodyStatus[]).map(status => [status, bodies.filter(({ body }) => body.status === status).length]));
  const problemRuns = records.filter(record => record.problems.length).length;
  const exit = error || lockLost || bench.malformed.length || problemRuns ? 1 : 0;
  const kept = bench.kept || bench.results.path.startsWith(`${bench.base}${sep}`);
  bench.results.write({
    kind: "bench-summary",
    copies,
    scripts: { measured: measured.size, skipped: bench.listed.length, malformed: bench.malformed.length },
    runs: records.length,
    processes: bench.processes,
    problemRuns,
    droppedCopies: records.reduce((sum, record) => sum + record.dropped, 0),
    bodies: statuses,
    keylessCompiles: [...bench.bounds.values()].reduce((sum, bound) => sum + bound.keylessCompiles, 0),
    listed: bench.listed,
    malformed: bench.malformed,
    loadAverage,
    lockLost,
    seconds: Math.round((performance.now() - started) / 1000),
    kept: kept ? bench.base : null,
    error,
    exit,
  });

  for (const [script, problems] of measured) {
    if (!problems) {
      console.log(`MEASURED ${script.display}${script.sequences.length > 1 ? ` (${script.sequences.length} sequences)` : ""}`);
      continue;
    }
    console.log(`PROBLEMS ${script.display}`);
    for (const record of records.filter(record => record.script === script.display && record.problems.length)) {
      const copiesOf = new Map<string, number[]>();
      for (const { copy, problem } of record.problems) copiesOf.set(problem, [...(copiesOf.get(problem) ?? []), copy]);
      for (const [problem, where] of copiesOf) {
        console.log(`  sequence ${record.sequence}, run ${record.run} (${record.role}${record.side === "native" ? ", native copy" : ""}), copies ${where.join(", ")}: ${problem}`);
      }
    }
  }
  for (const line of bench.malformed) console.log(`MALFORMED ${line}`);
  for (const line of bench.listed) console.log(`listed: ${line}`);
  if (error) console.log(`ERROR ${error}`);
  if (lockLost) console.log("ERROR the build lock's holder exited before the bench released it, so a build may have overlapped the bench");
  if (bodies.length) {
    console.log(`installation bound: ${Object.entries(statuses).map(([status, count]) => `${count} ${status}`).join(", ")}; coverage over every script, per script in the results:`);
    for (const row of coverage.filter(row => row.script === null)) {
      console.log(`  S ${String(row.smallestBody).padStart(4)}: ${String(row.covered).padStart(5)} bodies, ${percentText(row.nativeShare).padStart(6)} of the native cost, ${percentText(row.excludedShare).padStart(6)} below S, ratio p50 ${ratioText(row.p50)}, p99 ${ratioText(row.p99)}, max ${ratioText(row.max)}`);
    }
  }
  const dropped = records.reduce((sum, record) => sum + record.dropped, 0);
  console.log(`${measured.size} scripts measured in ${copies} copies, ${problemRuns} runs with problems, ${dropped} run copies dropped, ${bench.listed.length} listed, ${bench.malformed.length} malformed`);
  console.log(`load average ${loadText(loadAverage.before)} before, ${loadText(loadAverage.after)} after`);
  if (profile.warning) console.log(`warning: ${profile.warning}`);
  if (kept) console.log(`kept: ${bench.base}`);
  else rmSync(bench.base, { recursive: true, force: true });
  console.log(`results: ${bench.results.path}`);
  return exit;
}

// ---------------------------------------------------------------------------------------------------------------------
// Helpers

export function readText(path: string): string | null {
  try {
    return readFileSync(path, "utf8");
  } catch {
    return null;
  }
}

function readBytes(path: string): Buffer {
  try {
    return readFileSync(path);
  } catch {
    return Buffer.alloc(0);
  }
}

function tail(text: string | null, lines = 12): string {
  if (!text) return "(no output)";
  return text.trimEnd().split("\n").slice(-lines).join("\n");
}

// Where two outputs first differ, by line.
function firstDifference(a: Buffer, b: Buffer): string {
  const left = a.toString("utf8").split("\n");
  const right = b.toString("utf8").split("\n");
  const clip = (line: string | undefined) => (line === undefined ? "(end of output)" : JSON.stringify(line.length > 160 ? `${line.slice(0, 160)}…` : line));
  for (let line = 0; line < Math.max(left.length, right.length); ++line) {
    if (left[line] !== right[line]) return `at line ${line + 1}: ${clip(left[line])}, oracle ${clip(right[line])}`;
  }
  return "in bytes that are not text";
}

// ---------------------------------------------------------------------------------------------------------------------

export async function main(argv: string[]): Promise<number> {
  let session: Session;
  try {
    const options = parseCommandLine(argv);
    const build = loadBuild(options.build);
    if (options.bun && !statSync(options.bun, { throwIfNoEntry: false })?.isFile()) throw new UsageError(`--bun names no file: ${options.bun}`);
    for (const path of options.testPaths) {
      if (!existsSync(path)) throw new UsageError(`no such test path: ${path}`);
    }
    if (options.bench) {
      if (build.emulated) throw new UsageError("--bench measures native processes, and an aarch64 build on an x86_64 host runs under QEMU");
      return await runBench(options, build);
    }
    session = new Session(options, build);
  } catch (error) {
    if (!(error instanceof UsageError)) throw error;
    console.error(`run-jitcache-tests: ${error.message}\n${usage}`);
    return 2;
  }
  console.log(`build ${session.build.directory}: ${session.mode} mode, ${session.build.architecture}${session.build.emulated ? ` under QEMU (${session.options.qemuCpu ?? "max"})` : ""}`);
  if (session.pinSetup) console.log(`pin ${session.pinSetup.pin.directory}${session.pinSetup.pinOptions.length ? `, this build's side with ${session.pinSetup.pinOptions.join(" ")}` : ""}`);
  try {
    if (!session.options.jsOnly) await runCppTests(session);
    if (!session.options.cppOnly) await runScripts(session);
  } catch (error) {
    if (!(error instanceof CalibrationError)) throw error;
    session.keep();
    return session.finish(error.message);
  }
  return session.finish(null);
}

if (import.meta.main) process.exit(await main(process.argv.slice(2)));
