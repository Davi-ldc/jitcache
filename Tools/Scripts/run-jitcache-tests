#!/usr/bin/env bun
// JITCache's test runner. It runs every JS script of the corpus as sequences of jsc or Bun processes over one artifact,
// checks each run (exit, checkers, final status, twin report), and compares every run that configures JITCache with a
// JITCache-off run of the same script, the oracle, which also tells the engine's leaks from JITCache's. With
// --pin it compares each oracle option set's code with the pin's, and it runs testjitcache's C++ tests, one process per
// part and options string. With --ladder it runs a twins build's whole verification and stops after the first rung that
// fails. With --bench it measures instead of testing: every plain-mode script in fresh copies with the bench report on,
// the minimum and median of each time span over the copies, and the installation bound per body. Every mode holds
// the machine lock (jitcache/lock.ts) from its first process on. This file holds the command line and main; the modules
// of Tools/Scripts/jitcache/ do the work, and the self-tests import them.

import { existsSync, statSync } from "node:fs";
import { resolve } from "node:path";
import { runCppTests } from "./jitcache/cpp.ts";
import { bunSource } from "./jitcache/env.ts";
import { runLadder } from "./jitcache/ladder.ts";
import { type Build, UsageError, loadBuild } from "./jitcache/launcher.ts";
import { holdMachineLock } from "./jitcache/lock.ts";
import { runBench } from "./jitcache/microbench.ts";
import { CalibrationError, type RunnerOptions, Session, runScripts } from "./jitcache/runs.ts";

// The copies of each sequence the bench runs when --bench-processes names no number.
const defaultBenchProcesses = 10;

const usage = `Usage: run-jitcache-tests --build=<WebKit build directory> [--bun=<Bun executable>] [--mode=twins|plain]
                         [--pin=<the pin's WebKit build directory>] [--pin-options="<options>"]
                         [--extra-options="<options>"] [--filter=<regex>] [--jobs=<n>] [--timeout=<seconds>]
                         [--js-only | --cpp-only] [--qemu-cpu=<model>] [--milestone] [<test paths>...]
       run-jitcache-tests --ladder --build=<twins WebKit build directory> [--bun=<Bun executable>]
                         [--pin=<the pin's WebKit build directory>] [--pin-options="<options>"]
                         [--plain-build=<plain WebKit build directory>] [--extra-options="<options>"] [--jobs=<n>]
                         [--timeout=<seconds>] [--qemu-cpu=<model>] [--milestone]
       run-jitcache-tests --bench --build=<WebKit build directory> [--bench-processes=<n>] [--bench-breakdowns]
                         [--filter=<regex>] [--timeout=<seconds>] [<test paths>...]
--build names <build-root>/linux-<arch>-<profile>/deps/WebKit. A test path is a script, or a directory whose scripts
are the .js and .mjs files below it, at any depth, outside every resources/ directory; the default path is the corpus,
JSTests/jitcache. A corpus script takes the defaults (its sequence when it declares none, and whether it requires
twins) of the nearest directory between it and the corpus that holds a defaults.txt. --filter selects scripts by their
path from JSTests/jitcache and C++ tests as <part>/<name>, where a test's part is the directory under
Source/JavaScriptCore/jitcache/tests/ that holds its file. --milestone also runs what a jitcache-cadence directive
leaves to milestones, such as image/budget.js's sweep; a cadence can also keep a script to one kind of build, as
image/islands.js runs only on release aarch64 builds. --pin names the build bun build.ts pin made, whose code each
jsc-hosted script's off path must emit; --pin-options adds options to this build's side of that comparison alone. The
runner's own tests, whose fixtures in JSTests/jitcache/integrator/runner/ fail on purpose and run only when a test path
names their files, run through bun JSTests/jitcache/integrator/runner/self-test.ts --build=<twins build>.
--ladder runs a twins build's whole verification in rungs and stops after the first rung that fails: the C++ tests;
the corpus in twins mode, with the Bun-hosted scripts under --bun and the pin comparison under --pin; Bun's own tests
under --bun; and the corpus in plain mode on the build --plain-build names. It lists each failure of the failing rung
with its file, and its last line names what did not run. --jobs bounds Bun's tests at once too, at most 4 of them.
--timeout bounds each process, which for Bun's tests is one bun test run, and a process that runs out of time is
killed with every process it started.
--bench measures a release-local build instead of testing it: the jsc-hosted scripts plain mode runs under --milestone,
each sequence in --bench-processes fresh copies (${defaultBenchProcesses} by default), one process at a time under the machine lock, with the
bench report on. --bench-breakdowns also times each request's counted parts and each install's steps
(jitCacheBenchBreakdowns), whose clock reads then raise every import's cost: such a run explains a bound and sets none.`;

// The options the bench mode refuses, since it runs plain mode's jsc-hosted scripts one process at a time with plain
// mode's command lines, adding no option but the one --bench-breakdowns names, natively and without C++ tests or the pin.
const notInBench = ["--mode", "--bun", "--pin", "--pin-options", "--extra-options", "--jobs", "--js-only", "--cpp-only", "--qemu-cpu", "--ladder", "--plain-build"];

// The options the ladder refuses: it runs the whole corpus and every C++ test, in the modes its rungs set.
const notInLadder = ["--mode", "--filter", "--js-only", "--cpp-only", "--bench", "--bench-processes", "--bench-breakdowns"];

export function parseCommandLine(argv: string[]): RunnerOptions {
  const options: RunnerOptions = {
    build: "",
    bun: null,
    mode: null,
    pin: null,
    pinOptions: [],
    extraOptions: [],
    filter: null,
    jobs: 5,
    timeoutSeconds: 600,
    jsOnly: false,
    cppOnly: false,
    qemuCpu: null,
    testPaths: [],
    milestone: false,
    bench: false,
    benchProcesses: defaultBenchProcesses,
    benchBreakdowns: false,
    ladder: false,
    plainBuild: null,
  };
  const given = new Set<string>();
  for (const argument of argv) {
    if (!argument.startsWith("--")) {
      options.testPaths.push(resolve(argument));
      continue;
    }
    const equals = argument.indexOf("=");
    const name = equals < 0 ? argument : argument.slice(0, equals);
    const value = equals < 0 ? null : argument.slice(equals + 1);
    given.add(name);
    const required = () => {
      if (value === null || value === "") throw new UsageError(`${name} needs a value`);
      return value;
    };
    switch (name) {
      case "--build":
        options.build = resolve(required());
        break;
      case "--bun":
        options.bun = resolve(required());
        break;
      case "--mode": {
        const mode = required();
        if (mode !== "twins" && mode !== "plain") throw new UsageError(`--mode is twins or plain, not ${mode}`);
        options.mode = mode;
        break;
      }
      case "--pin":
        options.pin = resolve(required());
        break;
      case "--pin-options":
        options.pinOptions = optionList(value ?? "", "--pin-options");
        break;
      case "--extra-options":
        options.extraOptions = optionList(value ?? "", "--extra-options");
        break;
      case "--filter":
        try {
          options.filter = new RegExp(required());
        } catch (error) {
          throw new UsageError(`--filter is no regular expression: ${(error as Error).message}`);
        }
        break;
      case "--jobs":
        options.jobs = positiveInteger(required(), name);
        break;
      case "--timeout":
        options.timeoutSeconds = positiveInteger(required(), name);
        break;
      case "--js-only":
      case "--cpp-only":
        if (value !== null) throw new UsageError(`${name} takes no value`);
        if (name === "--js-only") options.jsOnly = true;
        else options.cppOnly = true;
        break;
      case "--qemu-cpu":
        options.qemuCpu = required();
        break;
      case "--milestone":
        if (value !== null) throw new UsageError("--milestone takes no value");
        options.milestone = true;
        break;
      case "--bench":
        if (value !== null) throw new UsageError("--bench takes no value");
        options.bench = true;
        break;
      case "--bench-processes":
        options.benchProcesses = positiveInteger(required(), name);
        break;
      case "--bench-breakdowns":
        if (value !== null) throw new UsageError("--bench-breakdowns takes no value");
        options.benchBreakdowns = true;
        break;
      case "--ladder":
        if (value !== null) throw new UsageError("--ladder takes no value");
        options.ladder = true;
        break;
      case "--plain-build":
        options.plainBuild = resolve(required());
        break;
      default:
        throw new UsageError(`unknown option ${argument}`);
    }
  }
  if (!options.build) throw new UsageError("--build is required");
  if (options.jsOnly && options.cppOnly) throw new UsageError("--js-only and --cpp-only exclude each other");
  if (options.pinOptions.length && !options.pin) throw new UsageError("--pin-options needs --pin");
  if (options.bench) {
    const refused = notInBench.filter(name => given.has(name));
    if (refused.length) throw new UsageError(`--bench takes no ${refused.join(", ")}: it runs plain mode's jsc-hosted scripts one process at a time, with plain mode's command lines`);
  } else {
    for (const name of ["--bench-processes", "--bench-breakdowns"]) {
      if (given.has(name)) throw new UsageError(`${name} needs --bench`);
    }
  }
  if (options.ladder) {
    const refused = notInLadder.filter(name => given.has(name));
    if (refused.length || options.testPaths.length) throw new UsageError(`--ladder takes no ${[...refused, ...(options.testPaths.length ? ["test paths"] : [])].join(", ")}: it runs the whole corpus and every C++ test`);
  } else if (options.plainBuild) {
    throw new UsageError("--plain-build needs --ladder");
  }
  return options;
}

function positiveInteger(text: string, name: string): number {
  const number = Number(text);
  if (!Number.isInteger(number) || number < 1) throw new UsageError(`${name} takes a positive integer, not ${text}`);
  return number;
}

// A space-separated list of --options, as --extra-options and a run's options are written.
function optionList(text: string, where: string): string[] {
  const options = text.split(/\s+/).filter(Boolean);
  for (const option of options) {
    if (!option.startsWith("--")) throw new UsageError(`${where} holds ${option}, which is no --option`);
  }
  return options;
}

export async function main(argv: string[]): Promise<number> {
  let session: Session;
  let plainBuild: Build | null = null;
  try {
    const options = parseCommandLine(argv);
    const build = loadBuild(options.build);
    if (options.bun && !statSync(options.bun, { throwIfNoEntry: false })?.isFile()) throw new UsageError(`--bun names no file: ${options.bun}`);
    for (const path of options.testPaths) {
      if (!existsSync(path)) throw new UsageError(`no such test path: ${path}`);
    }
    if (options.bench) {
      if (build.emulated) throw new UsageError("--bench measures native processes, and an aarch64 build on an x86_64 host runs under QEMU");
      holdMachineLock();
      return await runBench(options, build);
    }
    if (options.ladder) {
      if (!build.twins || !statSync(build.testjitcache, { throwIfNoEntry: false })?.isFile()) throw new UsageError(`--ladder needs a twins build, whose bin/testjitcache its first rung runs, and ${build.directory} is none`);
      // bun test starts Bun processes of its own, which QEMU user mode does not run.
      if (options.bun && build.emulated) throw new UsageError("--ladder runs Bun's tests natively, and an aarch64 build on an x86_64 host runs under QEMU");
      if (options.bun && !statSync(bunSource, { throwIfNoEntry: false })?.isDirectory()) throw new UsageError(`--ladder runs Bun's tests from the Bun checkout ${bunSource}, which is missing; JITCACHE_BUN_SOURCE names another`);
      if (options.plainBuild) {
        plainBuild = loadBuild(options.plainBuild);
        if (plainBuild.twins || plainBuild.architecture !== build.architecture) throw new UsageError(`--plain-build names ${plainBuild.directory}, which is no plain ${build.architecture} build`);
      }
    }
    session = new Session(options, build);
  } catch (error) {
    if (!(error instanceof UsageError)) throw error;
    console.error(`run-jitcache-tests: ${error.message}\n${usage}`);
    return 2;
  }
  holdMachineLock();
  console.log(`build ${session.build.directory}: ${session.mode} mode, ${session.build.architecture}${session.build.emulated ? ` under QEMU (${session.options.qemuCpu ?? "max"})` : ""}`);
  if (session.pinSetup) console.log(`pin ${session.pinSetup.pin.directory}${session.pinSetup.pinOptions.length ? `, this build's side with ${session.pinSetup.pinOptions.join(" ")}` : ""}`);
  if (session.options.ladder) return await runLadder(session, plainBuild);
  try {
    if (!session.options.jsOnly) await runCppTests(session);
    if (!session.options.cppOnly) await runScripts(session);
  } catch (error) {
    if (!(error instanceof CalibrationError)) throw error;
    session.keep();
    return session.finish(error.message);
  }
  return session.finish(null);
}

if (import.meta.main) process.exit(await main(process.argv.slice(2)));
